// Pattegrisen: Claus Eriksen's pink Danish coastal shrimp, tied with the shrimp's head at the bend.

id pattegrisen
name "Pattegrisen"
aliases "Pink Pig" "Pattegris"
type saltwater
imitates crustacean
difficulty intermediate
species sea-trout
season january february march april may june july august september october november december
origin originator="Claus Eriksen" year=2006 region="Funen, Denmark"
description "A reversed shrimp in shell pink: hackle-stem and synthetic-hair feelers, a Spey hackle collar and black eyes at the bend, a tapered SLF body with a palmered Spey hackle, and an Antron shellback segmented by a mono rib."
history """
    Claus Eriksen tied it on Funen in 2006, and its tenth birthday was celebrated in Odense in
    2016. It grew out of Morten Øland's Spey Shrimp (also called Oeland's Shrimp), a more
    neutral grey fly, which Eriksen redid in pink and coral with some materials changed. It was
    one of the flies in two Danish sea-trout films released in 2006 that were known for their
    underwater footage of sea trout following flies. The key material is a long, thin Spey
    hackle; the Ahrex video names Whiting Spey feathers. Eriksen has tied it in all colours,
    and says the pink catches best.
    """
fishing """
    A Danish coastal fly for sea trout. Eriksen fishes it as the point fly in all conditions,
    bright sun and flat calm included, often with a small grey gammarus about 50 cm up the
    leader. He uses sizes 4 to 6 even in midsummer and early autumn, when the usual advice is
    small flies on fine leaders. It has also taken salmon, steelhead, bonefish and tarpon.
    """
sources {
    "GlobalFlyFisher: The Pink Pig, Pattegrisen (Kasper Mühlbach)" url="https://globalflyfisher.com/patterns/pink-pig-pattegrisen"
    "Ahrex: Pattegrisen, a fairytale and a birthday (Michael Jensen)" url="https://ahrexhooks.com/2016/11/11/pattegrisen-a-fairytale-and-a-birthday/"
    "GlobalFlyFisher: Pattegrisen (Ahrex video, Jesper Lindquist Andersen)" url="https://globalflyfisher.com/video/pattegrisen"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://globalflyfisher.com/sites/default/files/imported_pictures/dsc_7119.jpg" page="https://globalflyfisher.com/patterns/pink-pig-pattegrisen" author="Kasper Mühlbach" license="All rights reserved; reference only" note="Side view in the vise, trimmed"
    "https://globalflyfisher.com/sites/default/files/imported_pictures/dsc_7116.jpg" page="https://globalflyfisher.com/patterns/pink-pig-pattegrisen" author="Kasper Mühlbach" license="All rights reserved; reference only" note="Side view in the vise"
}

// Assumption: a straight saltwater hook, like the Ahrex NS122 stinger in the Ahrex video;
// the GFF recipe's Partridge CS54 is a curved shrimp hook.
// Assumption: colours read from the GFF photos: a coral body and back, pale pink Spey hackles.
hook saltwater-straight size=6
thread pink size="8/0"

materials {
    weight lead-free-wire label="Lead-free wire, or tungsten foil under the shank"
    feelers hackle-fibres color=white count=2 label="White hackle stems"
    mouth saddle-hackle color="#e3bcb6" fibre=1.6 sweep=60 label="Shrimp-pink Spey hackle"
    antennae synthetic-hair color="#f2a39a" count=14 label="Shrimp-pink Ultra Hair"
    eyes mono-eyes mm=2
    rib monofilament
    body dubbing color="#e0645a" label="Shell-pink SLF"
    legs saddle-hackle color="#e3bcb6" fibre=2.0 sweep=55 label="Shrimp-pink Spey hackle"
    back poly-yarn color="#e87a6a" label="Shrimp-pink Antron yarn"
}

steps {
    weight weight from=0.25 to=0.75
    attach-thread at=0.85
    wrap-thread to=0.0
    tie-in feelers length=2.2 angle=10 spread=30 note="Splayed apart."
    tie-in mouth note="The mouth parts."
    wrap-thread to=0.05
    wind mouth to=0.05 turns=3 note="A collar round the feelers."
    tie-off mouth
    // GFF: fairly long; in the photos about one and a half to two hook lengths.
    tie-in antennae length=2.8 angle=5 spread=15
    tie-in eyes note="Angled slightly outwards."
    tie-in rib
    // Assumption: the shellback is tied in here and pulled forward; the GFF steps tie it in at the eye and take it back to the bend.
    tie-in back
    tie-in legs
    dub body to=0.86 note="Tapered: thickest at the bend, slimmer toward the eye."
    wind legs to=0.86 turns=6 note="Fibres down and back."
    tie-off legs
    pull-over back to=0.86 note="Over the top, stretched."
    wind rib to=0.86 turns=8 note="Over the shellback, the turns closer together toward the eye."
    tie-off rib
    whip-finish note="Brush out the underside, trim, and varnish the head and a little of the back."
}
