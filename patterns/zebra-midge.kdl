// Zebra Midge: Ted Welling's bead-head midge pupa from Lees Ferry: a thread body ribbed with silver wire.

id zebra-midge
name "Zebra Midge"
type midge
imitates chironomid
naturals midge-pupa
difficulty beginner
species trout
season january february march april may june july august september october november december
origin originator="Ted Welling" region="Lees Ferry, Arizona, USA"
description "A slim tapered black thread body with a silver wire rib, behind a silver bead, on a short curved hook."
history """
    Created by Ted Welling, a guide at Lees Ferry on the Colorado River in Arizona, a
    tailwater full of midges at the head of the Grand Canyon. Ralph Scherder dates it to
    about 1996 and sees it as a variation of Kelly Davidson's Ice Cream Cone, a 1992
    chironomid for British Columbia lakes; other sources give no date or ancestor.
    """
fishing """
    Imitates a midge pupa that sinks quickly; McFly Angler argues the silver bead makes it
    an emerger. Fish it under an indicator, below a dry fly, or as a dropper behind a larger
    fly such as a San Juan Worm or egg; Pat Dorsey, cited by Orvis News, finds fish are
    often drawn by the big fly but take the midge. It works all year, best from autumn to early spring, on tailwaters, freestones and
    lakes. Red and olive bodies are popular colour variants.
    """
sources {
    "Orvis News: Tying the Zebra Midge (Phil Monahan, video by Tim Flagler)" url="https://news.orvis.com/fly-fishing/Tying-the-Zebra-Midge"
    "Into Fly Fishing: How to tie the Zebra Midge (Pierre Joubert)" url="https://intoflyfishing.com/how-to-tie-the-zebra-midge/"
    "Dark Skies Fly Fishing: Small but mighty, fishing the Zebra Midge (Ralph Scherder)" url="https://darkskiesflyfishing.com/post/small-but-mighty-fishing-the-zebra-midge/"
    "gbflycasters.org: Zebra Midge" url="https://gbflycasters.org/fly_tying/patterns/Zebra_Midge/Zebra_Midge.htm"
    "GlobalFlyFisher: Zebra Midge and variations (McFly Angler)" url="https://globalflyfisher.com/video/zebra-midge-and-variations"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://flyfishsd.com/cdn/shop/articles/zebra-midge-fly-pattern.jpg?v=1686269752" page="https://flyfishsd.com/blogs/blog/zebra-midge-fly-tying-video" license="All rights reserved; reference only" note="Side view in the vise"
    "https://gbflycasters.org/fly_tying/patterns/Zebra_Midge/Zebra_Midge.jpg" page="https://gbflycasters.org/fly_tying/patterns/Zebra_Midge/Zebra_Midge.htm" license="All rights reserved; reference only" note="Side view, glass bead variant"
}

hook scud-curved size=18
thread black size="8/0"

materials {
    // Assumption: a 1.5 mm (1/16") bead on a #18.
    bead brass-bead color=silver mm=1.5
    rib silver-wire
}

steps {
    slide-bead bead note="Small hole first, up against the eye."
    attach-thread at=0.9 note="Right behind the bead, with a small dam so it can't slide back."
    wrap-thread to=0.0 note="Partway down the bend."
    tie-in rib note="On the near side."
    wrap-thread to=0.9
    wrap-thread to=0.35
    wrap-thread to=0.9 note="Build a slim taper: thinnest at the rear, thickest behind the bead."
    wind rib to=0.9 turns=6 note="Evenly spaced open turns."
    tie-off rib
    whip-finish note="Behind the bead."
}
