// Brassie: a copper wire body and a peacock herl head; a 1960s South Platte classic.

id brassie
name "Brassie"
type midge
imitates chironomid
difficulty beginner
species trout
season january february march april may june july august september october november december
origin region="South Platte River, Colorado, USA, 1960s"
description "A body of copper wire in touching turns and a small peacock herl head."
history """
    From the South Platte in Colorado in the 1960s. Rusty Dunn credits Gene Lynch of
    Colorado Springs, with Ken Chandler and Tug Davenport refining it: Lynch had wrapped bare
    hooks with copper wire as underbodies for weighted nymphs, and when he fished one as a
    weight ahead of a nymph, the fish took the bare wire hook instead. Pierre Joubert reports
    only a claim that an electronics hobbyist created it. It is named after the brass-plated copper
    wire of the originals, which had heads of black heat-shrink tubing.
    """
fishing """
    A heavy, slim fly that sinks quickly, suggesting midge and caddis larvae. In rivers,
    fish it deep in a nymph rig or below a dry fly; on lakes it can be fished like a
    buzzer, behind other flies with a figure-of-eight retrieve. Plain copper is the usual
    wire, with red and green close behind, and many tie it with a bead.
    """
sources {
    "SWTU: South Platte Brassie (Rusty Dunn)" url="https://www.swtu.org/2018/10/02/south-platt-brassie/"
    "Orvis: Brassie" url="https://howtoflyfish.orvis.com/fly-tying-videos/nymph-flies/688-brassie"
    "Into Fly Fishing: How to tie a Brassie fly (Pierre Joubert)" url="https://intoflyfishing.com/how-to-tie-a-brassie/"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://www.swtu.org/wp-content/uploads/2018/10/South-Platte-Brassie2-975.jpg" page="https://swtu.org/?p=1501" license="All rights reserved; reference only" note="Side view, classic unbeaded"
    "https://intoflyfishing.com/wp-content/uploads/2020/06/How-To-Tie-A-Brassie-Fly-Featured-Image.jpg" page="https://intoflyfishing.com/?p=3214" license="All rights reserved; reference only" note="Side view in the vise"
}

hook wet-standard size=18
thread black size="8/0"

materials {
    // Assumption: "Brassie" size wire, about 0.28 mm.
    body copper-wire mm=0.28
    head peacock-herl strands=1
}

steps {
    attach-thread at=0.85 note="Leave room for the head."
    wrap-thread to=0.0 note="Binding the wire along the near side, for a smooth underbody."
    tie-in body
    wrap-thread to=0.75
    wind body to=0.75 turns=18 note="Tight, touching turns, by hand; nudge them together."
    tie-off body note="Break the wire off by flexing it."
    tie-in head
    wrap-thread to=0.92
    wind head to=0.92 turns=3 note="A short, fat herl head."
    tie-off head
    whip-finish
}
