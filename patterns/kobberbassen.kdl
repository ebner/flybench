// Kobberbassen: the Danish copper gammarus for the coast, little more than copper dubbing on a hook.

id kobberbassen
name "Kobberbassen"
aliases "Copper Bully" "Kobberlusen" "Copper Louse"
type saltwater
imitates crustacean
difficulty beginner
species sea-trout
season january february march april may june july august september october november december
origin originator="Frank Jensen" year=1996 region="Denmark"
description "A short Krystal Flash tail and a shaggy, teased-out copper dubbing body with a copper wire rib, on a short-shank, wide-gape hook."
history """
    Frank Jensen's fly from 1996. GlobalFlyFisher sees it as two strains run together: Jensen's
    Kobberbassen and Morten Kristiansen's Kobberlusen, the Copper Louse, which began as a
    somewhat more complex fly. Both share the copper dubbed body, and the names now cover much
    the same fly. Tyers add tails, shellbacks, legs and ribs, but in GlobalFlyFisher's words
    "essentially all you need is copper dubbing of some kind".
    """
fishing """
    A sea-trout fly for clear, shallow coastal water where gammarids are about, often fished as
    a small dropper ahead of a bigger point fly. Retrieve it in short pulls with stops, or with
    a steady hand-twist, to copy the darting and gliding of the naturals. Tied small it also
    serves in fresh water as a scud or cress bug.
    """
sources {
    "GlobalFlyFisher: The Copper Bully (Martin Joergensen, Ken Bonde Larsen)" url="https://globalflyfisher.com/patterns/copper-bully"
    "GlobalFlyFisher: Kobberbassen (Ahrex video, Jesper Lindquist Andersen)" url="https://globalflyfisher.com/video/kobberbassen"
    "Sexyloops: Another ugly fly (Rickard Gustafsson)" url="https://www.sexyloops.com/index.php/ps/another-ugly-fly"
    "Fishmadman: Kobberbassen #8" url="https://rifflinghitch.com/product/kobberbassen-8/"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://rifflinghitch.com/wp-content/uploads/2019/04/TF2028-Kobberbassen-8-1.jpeg" page="https://rifflinghitch.com/product/kobberbassen-8/" license="All rights reserved; reference only" note="Side view, wide-gape hook"
    "https://globalflyfisher.com/sites/default/files/imported_pictures/translucent.jpg" page="https://globalflyfisher.com/patterns/copper-bully" license="All rights reserved; reference only" note="Side view, teased out"
}

// Assumption: a short, wide-gape curved hook like the Kamasan B980 GFF recommends.
hook emerger-curved size=10
thread orange size="6/0"

materials {
    tail krystal-flash color=copper count=6
    rib copper-wire
    body dubbing color="#9a5a3a" label="Copper Lite Brite or Angel Hair"
}

steps {
    attach-thread at=0.9
    wrap-thread to=0.0
    // Assumption: just a hint beyond the bend, read from the photos.
    tie-in tail length=0.4 note="A few strands, trimmed short."
    tie-in rib
    dub body to=0.88 note="A loose noodle, fuller in the middle and front like a scud's back."
    wind rib to=0.88 turns=5 note="Open turns; tease the dubbing out underneath first."
    tie-off rib
    whip-finish note="Tease again so the fibres stream back and down."
}
