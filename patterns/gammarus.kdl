// Gammarus: a freshwater shrimp (scud), after the Orvis Simple Scud.

id gammarus
name "Gammarus"
aliases "Scud" "Freshwater shrimp" "Simple Scud"
type nymph
imitates crustacean
difficulty beginner
species trout grayling sea-trout
season january february march april may june july august september october november december
description "A plump olive dubbed body on a curved hook, a tan shellback and a gold wire rib, with the dubbing brushed out underneath for legs."
history """
    Not one pattern but a family: imitations of the freshwater shrimps (Gammarus and other
    amphipods) that trout and grayling eat all year. This is the plain dubbed, shellbacked
    and ribbed scud; Oliver Edwards' Deep Diving Shrimp and Nick Thomas' Shwimp are
    well-known relatives. Orange and pink versions are fished for sea trout on Scandinavian
    coasts.
    """
fishing """
    Fish it near the bottom: the naturals live among weed, gravel and stones, though trout
    take imitations almost anywhere in lakes and streams, especially on overcast days. Nick
    Thomas fishes his weighted Shwimp on a dropper for winter grayling on big rivers, and
    on its own in plunge pools on small streams. Weight decides the depth: the Simple Scud
    has none, the Deep Diving Shrimp has lead-free foil, the Shwimp a tungsten bead.
    """
sources {
    "Orvis: Simple Scud" url="https://howtoflyfish.orvis.com/fly-tying-videos/nymph-flies/662-simple-scud"
    "GlobalFlyFisher: OE Deep Diving Shrimp (Kasper Mühlbach)" url="https://globalflyfisher.com/patterns-tie-better/oedds"
    "GlobalFlyFisher: Shwimp (Nick Thomas)" url="https://globalflyfisher.com/shwimp"
    "Ahrex: Gammarus, small but important (Michael Jensen)" url="https://ahrexhooks.com/2017/11/23/gammarus-small-but-important/"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://www.1000flies.com/media/image/product/23137/lg/classic-gammarus-fluo-orange.jpg.webp" page="https://www.1000flies.com/Classic-Gammarus-Fluo-Orange_3" license="All rights reserved; reference only" note="Side view: tail, rib, shell, legs"
    "https://globalflyfisher.com/sites/default/files/imported_pictures/IMG_2890.jpg" page="https://globalflyfisher.com/patterns-tie-better/oedds" author="Kasper Mühlbach" license="All rights reserved; reference only" note="Side view in the vise"
}

hook scud-curved size=12
thread olive size="8/0"

materials {
    antennae hackle-fibres color=olive count=6 label="Olive fibres (antennae)"
    rib gold-wire
    back scud-back color=tan
    body dubbing color=olive label="Smoky olive scud dubbing"
}

steps {
    attach-thread at=0.67
    wrap-thread to=0.0
    // Assumption: antennae about a third of the shank, as in the reference photos.
    tie-in antennae length=0.6 note="A thin wisp, trimmed short."
    tie-in rib
    tie-in back note="Wrapped back into the bend, centred on top."
    dub body to=0.92 note="A plump body tapering at both ends, stopping short of the eye."
    pull-over back to=0.92
    wind rib to=0.92 turns=8 note="Open turns over shell and body; firmer pressure gives deeper segments."
    tie-off rib
    whip-finish note="Brush out the dubbing underneath for legs about a gape long."
}
