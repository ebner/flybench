// Foam Beetle: a black foam shellback over a peacock body, with an orange sighter.

id foam-beetle
name "Foam Beetle"
type terrestrial
imitates terrestrial
difficulty beginner
species trout panfish bass
season june july august september
origin region="United States"
description "A black foam shell folded over a peacock herl body, black legs at the sides and a small orange sighter on top."
history """
    No one is credited with it. It is the foam descendant of the folded deer-hair Crowe Beetle,
    developed and popularised by John Crowe of Johnstown, Pennsylvania. A Crowe Beetle could be
    torn apart by one or two fish; a foam one often survives a dozen. When foam replaced the
    deer hair is not recorded.
    """
fishing """
    Cast it tight to banks and under overhanging grass and trees in summer, landing it with an
    audible plop, then dead-drift it or give it a small twitch. It floats indefinitely, and the
    sighter makes the low-riding black fly visible; it is also a good top fly for a dry-dropper.
    """
sources {
    "Fly Fisherman: Foam Beetle (Charlie Craven)" url="https://www.flyfisherman.com/editorial/fly-tying-foam-beetle/151931"
    "Fly Fishers Paradise: Foam Beetle" url="https://flyfishersparadise.com/fly-tying/foam-beetle"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://upload.wikimedia.org/wikipedia/commons/6/66/Black_Foam_Beetle.jpg" page="https://commons.wikimedia.org/wiki/File:Black_Foam_Beetle.jpg" author="Mike Cline" license="CC BY-SA 4.0" note="Side view, with an orange sighter"
    "https://upload.wikimedia.org/wikipedia/commons/7/77/Foam_beetle.jpg" page="https://commons.wikimedia.org/wiki/File:Foam_beetle.jpg" author="Mike Cline" license="CC BY-SA 4.0" note="Side view"
}

hook dry-standard size=12
thread black size="6/0"

materials {
    back foam color=black label="Black foam strip, as wide as the gape"
    body peacock-herl strands=4
    // Assumption: legs from a black hackle trimmed top and bottom (the Fly Fishers Paradise way), in place of Craven's moose hairs.
    legs cock-hackle color=black fibre=1.1
    sighter poly-yarn color=orange label="Orange foam or yarn sighter"
}

steps {
    attach-thread at=0.75 note="Craven ties the pointed end of the foam in here and binds it back on top of the shank."
    wrap-thread to=0.0
    tie-in back note="Bound down on top to just past the bend, the long end trailing."
    tie-in body
    wrap-thread to=0.5
    tie-in legs
    wrap-thread to=0.84
    wind body to=0.84 turns=9 note="Touching turns, past the legs to just behind the eye."
    tie-off body
    wind legs to=0.84 turns=3 note="A few open turns through the front of the body."
    tie-off legs
    wrap-thread to=0.88
    pull-over back to=0.88 note="Fold it over the body and lock it down with a few tight turns; leave a short stub over the eye as the head."
    tie-in sighter length=0.35 angle=25 note="A narrow strip on top at the joint, trimmed short."
    whip-finish note="At the joint."
    // Craven: legs slightly longer than the gape, out to the sides.
    trim legs keep=sides note="Cut the fibres top and bottom, leaving legs at the sides."
}
