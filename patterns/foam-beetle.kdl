// Foam Beetle: a black foam shellback over a peacock body, with an orange sighter.

id foam-beetle
name "Foam Beetle"
type terrestrial
imitates terrestrial
naturals beetle
difficulty beginner
species trout panfish
season june july august september
origin region="United States"
description "A black foam shell folded over a peacock herl body, moose hair legs at the sides and a small orange sighter on top."
history """
    The sources credit no one with it. It is the foam descendant of the folded deer-hair Crowe
    Beetle, developed and popularised by John Crowe of Johnstown, Pennsylvania. Deer hair wears
    out quickly, often after a fish or two, while a foam beetle can last through a dozen. None
    of the sources says when foam took over from deer hair.
    """
fishing """
    Fish it close to the banks in summer, when beetles fall in. Let it land with a plop: George
    Daniel points out that trout lying deep under an undercut bank may feel the impact before
    they see the fly. The foam keeps it afloat, and the sighter makes the low-riding black fly
    easier to follow. Beetles are also a standby for panfish.
    """
sources {
    "Fly Fisherman: Foam Beetle (Charlie Craven)" url="https://www.flyfisherman.com/editorial/fly-tying-foam-beetle/151931"
    "Fly Fishers Paradise: Foam Beetle" url="https://flyfishersparadise.com/fly-tying/foam-beetle"
    "Gink & Gasoline: Sudden impact, fishing a better beetle (George Daniel)" url="https://www.ginkandgasoline.com/fly-fishing-tips-technique/sudden-impact-fishing-a-better-beetle/"
    "Panfish On The Fly: Terrestrial patterns for panfish" url="https://www.panfishonthefly.com/blog/2020/3/30/terrestrial-patterns-for-panfish"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://upload.wikimedia.org/wikipedia/commons/6/66/Black_Foam_Beetle.jpg" page="https://commons.wikimedia.org/wiki/File:Black_Foam_Beetle.jpg" author="Mike Cline" license="CC BY-SA 4.0" note="Side view, with an orange sighter"
    "https://upload.wikimedia.org/wikipedia/commons/7/77/Foam_beetle.jpg" page="https://commons.wikimedia.org/wiki/File:Foam_beetle.jpg" author="Mike Cline" license="CC BY-SA 4.0" note="Side view"
}

// Assumption: It floats well but low, the body and the lower part of the foam in and under the
// film (Orvis; photos of foam terrestrials on the water).
sits half
hook dry-standard size=12
thread black size="6/0"

materials {
    back foam color=black label="Black foam strip, as wide as the gape"
    body peacock-herl strands=4
    legs moose-mane count=3 label="Moose hair (legs)"
    sighter poly-yarn color=orange label="Orange foam or yarn sighter"
}

steps {
    attach-thread at=0.75 note="Craven ties the pointed end of the foam in here and binds it back on top of the shank."
    wrap-thread to=0.0
    tie-in back note="Bound down on top to just past the bend, the long end trailing."
    tie-in body
    wrap-thread to=0.5
    // Craven: legs slightly longer than the gape.
    tie-in legs length=1.1 angle=20 side=across note="Six moose hairs crosswise, three a side."
    wrap-thread to=0.84
    wind body to=0.84 turns=9 note="Touching turns, past the legs to just behind the eye."
    tie-off body
    wrap-thread to=0.88
    pull-over back to=0.88 note="Fold it over the body and lock it down with a few tight turns."
    // Craven: a short stub over the eye as the head.
    trim back leave=0.3
    tie-in sighter length=0.35 angle=25 note="A narrow strip on top at the joint, trimmed short."
    whip-finish note="At the joint; pull the legs down and trim them."
}
