// Peeping Caddis as Oliver Edwards and Graydon Bell tie it: the larva at the front, as in nature.

id peeping-caddis-edwards
name "Peeping Caddis"
variant-of peeping-caddis
variant "Edwards, larva at the front"
type nymph
imitates caddis
naturals caddis-larva-cased
difficulty intermediate
species grayling trout
season january february march april may june july august september october november december
origin originator="Oliver Edwards and Graydon Bell" region="England"
description "A lead-weighted hare's mask case over the rear two thirds of a long-shank hook, with a white larva lying forward to a dark head at the eye and its legs underneath."
history """
    Oliver Edwards' realistic cased caddis, here as Graydon Bell ties it: the grub comes out of
    the front of the case, where a real larva's head and legs are, and the hare's mask case is
    built over a flat lead underbody. Fulling Mill's OE Peeping Caddis gets its weight from a
    split shot instead.
    """
fishing """
    Fished slowly along the bottom of rivers, for trout, and for grayling in winter.
    """
sources {
    "Fish4Flies: Peeping Caddis (Edwards and Bell)" url="https://www.fish4flies.com/Nymphs/Caddis-and-Larva-and-Pupa/Peeping-Caddis"
    "Fly Anglers Online: Cased Caddis (Mike Murgida, after Oliver Edwards)" url="https://www.flyanglersonline.com/t/cased-caddis-fly-pattern/2945"
    "Fulling Mill: OE Peeping Caddis" url="https://www.fullingmill.co.uk/Products-UK/Tactical-River-Nymphs-UK/OE-Peeping-Caddis-Debris-S10-UK"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://www.fish4flies.com/img/flies/Large/T4085Peeping%20Caddis.jpg" page="https://www.fish4flies.com/Nymphs/Caddis-and-Larva-and-Pupa/Peeping-Caddis" author="Graydon Bell" license="All rights reserved; reference only" note="Side view, larva at the front"
}

hook nymph-2xl size=10
thread black size="8/0"

materials {
    weight lead-free-wire label="Lead-free wire (Bell uses flat lead)"
    larva-case hares-ear-dubbing label="Hare's mask dubbing brush"
    // Fly Anglers Online gives golden pheasant centre tail for the legs; Fish4Flies lists peacock.
    legs pheasant-tail count=8 label="Golden pheasant centre tail fibres (legs)"
    larva wool color=cream label="White or glow yarn (larva)"
}

steps {
    weight weight from=0.1 to=0.65 note="Flattened, under the case."
    attach-thread at=0.7
    wrap-thread to=0.0
    dub larva-case to=0.66 note="Thick and rough over the rear two thirds."
    tie-in legs length=0.6 angle=30 side=under note="Under the shank, sloping back."
    // Assumption: the larva covers the front third and ends at the eye.
    tie-in larva length=0.85 extended=#true forward=#true tip=brown note="The top of the head tinted dark with a marker."
    wrap-thread to=0.95
    whip-finish note="A small black head at the eye."
}
