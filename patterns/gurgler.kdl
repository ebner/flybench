// Gurgler: Jack Gartside's foam popper of 1988, a shell of foam pulled over the body with its end left as a lip over the eye.

id gurgler
name "Gurgler"
aliases "Gartside Gurgler"
type saltwater
fishes surface
imitates baitfish attractor
naturals fry-minnow marine-baitfish
difficulty intermediate
species striped-bass bass
season may june july august september october
origin originator="Jack Gartside" year=1988 region="Bahamas"
description "A sparse white bucktail tail with pearl flash, a pearl chenille body under a palmered white saddle hackle, and a white foam shell pulled over the top and left as a lip over the eye."
history """
    Jack Gartside, the Massachusetts tyer and writer, made it on a trip to the Bahamas in 1988
    as a topwater fly for jacks, tarpon and snook. In his own dressing the same strip of foam
    does twice: its front part is cupped round the shank and bound into five segments as the
    body, with a saddle hackle palmered in the grooves, and the rest is pulled forward over it
    as the shell, the end left sticking out over the eye as a lip. Most tyers today put a
    chenille or braid body under the shell instead, as here, and some tie a scrap of foam
    behind the lip to hold it up.
    """
fishing """
    Stripped in short, sharp pulls the lip digs in and throws water; long, slow pulls wake it,
    and it can be left still between them. A fly for stripers, blues and albies, for snook and
    tarpon, and for bass in fresh water; Gartside's own site lists everything from bonefish to
    trout. It floats on its foam with the body and tail hanging in the film.
    """
sources {
    "Jack Gartside: The Gurgler, step by step" url="https://jackgartside.com/step_gurgler.htm"
    "Jack Gartside: blog (webmaster's post on the Gurgler)" url="https://www.jackgartside.com/wordpress/?p=643"
    "On The Water: The Gurgler fly (Pete Barrett)" url="https://onthewater.com/the-gurgler-fly"
    "Into Fly Fishing: How to tie a Gurgler (Pierre Joubert)" url="https://intoflyfishing.com/how-to-tie-a-gurgler/"
    "Orvis Learning Center: Gurgler" url="https://howtoflyfish.orvis.com/fly-tying-videos/salt-bass-streamer-flies/648-gurgler"
    "Wikipedia: Jack Gartside" url="https://en.wikipedia.org/wiki/Jack_Gartside"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://upload.wikimedia.org/wikipedia/commons/6/63/Original_Gurgler.jpg" page="https://commons.wikimedia.org/wiki/File:Original_Gurgler.jpg" author="Mike Cline" license="CC BY-SA 4.0" note="Side view in the vise"
    "http://jackgartside.com/images/flysteps/gurgler_feathered.jpg" page="https://jackgartside.com/step_gurgler.htm" author="Jack Gartside" license="All rights reserved; reference only" note="Gartside's own, side view"
}

sits half
hook saltwater-straight size=2
thread white size="3/0"

materials {
    tail bucktail color=white label="Sparse white bucktail"
    flash krystal-flash count=6 label="Pearl Glimmer or Krystal Flash"
    shell foam color=white label="White closed-cell foam, 3 mm"
    body chenille color=pearl label="Pearl crystal chenille"
    hackle saddle-hackle color=white fibre=1.2 label="White saddle hackle"
}

steps {
    attach-thread at=0.9
    wrap-thread to=0.0
    // Gartside: about one and a half shanks; the Cline photo shows about two.
    tie-in tail length=4.0 angle=0 spread=25 note="A very sparse bunch."
    tie-in flash length=3.8 note="Five or six strands on top of the tail."
    tie-in shell note="A strip about half an inch wide, its end tapered, trailing back over the tail."
    tie-in body
    tie-in hackle note="By the tip, one side stripped."
    wrap-thread to=0.88
    wind body to=0.88 turns=10
    tie-off body
    wind hackle to=0.88 turns=6 note="Palmered forward over the body."
    tie-off hackle
    // Read from the photos: the shell domes about a gape over the shank.
    pull-over shell to=0.88 bubble=0.45 note="Forward over the top, cupping the sides, and tied down snugly behind the eye."
    // Gartside: about half an inch past the eye; the Cline photo shows about 1.2 gapes.
    trim shell leave=1.2 note="Leave the lip sticking out over the eye, cut straight across or rounded."
    whip-finish
}
