// Elk Hair Caddis after Al Troth's 1978 article: the hair butts left untrimmed
// (sources disagree on the head; see history).

id elk-hair-caddis-troth
name "Elk Hair Caddis"
variant-of elk-hair-caddis
variant "Troth original"
type dry
imitates caddis
naturals caddis-adult
difficulty intermediate
species trout grayling
season may june july august september
origin originator="Al Troth" year=1957 region="Pennsylvania, USA"
description "The Elk Hair Caddis after Troth's 1978 article: the hair butts left long instead of trimmed into a neat head."
history """
    Troth described the fly in the Fall 1978 issue of Fly Tyer; Rusty Dunn notes it had already
    appeared in Terry Hellekson's Popular Fly Patterns in 1976. Fly Tyer's own reprint of his
    dressing, the Federation of Fly Fishers' 1998 Fly of the Month and the Fly Fishers
    International (FFI) skills award version give a fine gold wire rib, which this variant
    follows. Fly Tyer notes that the article does not mention the clipped-hair head, which other
    tyers added; Rusty Dunn, on the other hand, has Troth trimming the butts into a head, and
    the 1998 Fly of the Month gives Al Troth's Elk Hair Caddis a squared-off trimmed head. The
    FFI version, meant to be as close to Troth's original as possible, still clips the butts,
    but at an angle in line with the wing rather than square.
    """
sources {
    "Fly Tyer: Elk-Hair Caddis" url="https://www.flytyer.com/elk-hair-caddis/"
    "Federation of Fly Fishers: Fly of the Month, Al Troth's Elk Hair Caddis (Jim Abbs)" url="https://www.flyfishersinternational.org/LinkClick.aspx?fileticket=oxRpfYt7i4I%3D&tabid=237&portalid=0&mid=1006"
    "Rocky River Trout Unlimited: Troth Elk Hair Caddis FFI" url="http://www.rockyrivertu.org/troth-elk-hair-caddis-ffi.html"
    "SWTU: Elk Hair Caddis (Rusty Dunn)" url="https://swtu.org/?p=422"
}

// Assumption: As the Elk Hair Caddis: damp, the body in the film under the wing; judged from
// the dressing.
sits body
hook dry-standard size=14
thread tan size="8/0"

materials {
    rib    gold-wire
    body   dry-fly-dubbing color=tan
    // The FFI says Troth liked the fibres 1½ × the gape, longer than modern dressings' (the
    // standard pattern's 0.8); the reviewer chose Troth's length for his version (2026-10-29).
    hackle cock-hackle color=brown fibre=1.5
    wing   elk-hair color=bleached
}

steps {
    attach-thread at=0.85
    wrap-thread to=0.0
    tie-in rib
    dub body to=0.75
    tie-in hackle
    wind hackle to=0.05 turns=5
    wind rib to=0.75 turns=5
    tie-off rib
    trim hackle
    tie-in wing length=2.3 angle=27 spread=75
    // Assumption: "untrimmed" butts; they are left as they are.
    whip-finish note="Whip finish behind the hair; the butts stay long."
}
