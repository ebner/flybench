// Ullsocken: the Mörrum "woolly sock", a segmented fly with three brown hackles in the Irish shrimp-fly style.

id ullsocken
name "Ullsocken"
aliases "Ullsock" "Woolly Sock"
type salmon
difficulty beginner
species salmon sea-trout
season may june july august september
origin region="River Mörrum, Sweden"
description "A red wool butt, two black wool body segments and three stiff brown cock hackles: at the rear, in the middle and at the front."
history """
    A Mörrum fly whose name is Swedish for "the wool sock". Its origins are unclear: Ahrex's video
    notes credit Alf Jansson in the 1960s and name the old Irish shrimp flies as its model, while
    Viking Lars dates it to the 1950s and says nobody knows who first tied it. Jan Grünwald recalls
    it as one of the two flies that took most of the Mörrum's May and June salmon in the early
    1980s. Viking Lars gives the original as a red wool butt, black wool bodies and stiff brown cock
    hackles, with no tail. Newer dressings from Mörrum add a red rear hackle and red flash, and
    Ahrex's notes suggest doubles, trebles and tubes as the ones to carry.
    """
fishing """
    Fished like any wet fly for salmon, across and down. Viking Lars catches late-summer and
    autumn salmon on it in Danish rivers, deep on a sinking shooting head. He prefers stiff cock
    hackles, which he thinks push water and vibrate rather than lie back in the current.
    """
sources {
    "Sexyloops: Foam and socks (Viking Lars)" url="https://www.sexyloops.com/index.php/ps/foam-and-socks"
    "GlobalFlyFisher: Woolly Sock - Ullsocken (Ahrex video, tied by Erik Hellquist)" url="https://globalflyfisher.com/video/woolly-sock-ullsocken"
    "GlobalFlyFisher: Ullsocken Tube (Ahrex video, tied by Stefan Enevoldsen)" url="https://globalflyfisher.com/video/ullsocken-tube"
    "GlobalFlyFisher: The Mörrum Fly (Kasper Mühlbach)" url="https://globalflyfisher.com/node/53445"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://globalflyfisher.com/sites/default/files/ullsocken-pages.jpg" page="https://globalflyfisher.com/review/morrum-best-flies" author="Peter Lyngby" license="All rights reserved; reference only" note="Book pages; treble version at top left"
    "https://img.youtube.com/vi/sECLVuOVDJs/maxresdefault.jpg" page="https://globalflyfisher.com/video/woolly-sock-ullsocken" license="All rights reserved; reference only" flip=#true note="Treble version, side view"
}

// Assumption: the original-style single-hook dressing (Viking Lars), without a tail.
hook salmon-up-eye size=6
thread black size="6/0"

materials {
    butt wool color=red
    rear cock-hackle color=brown fibre=1.4 sweep=45 label="Stiff brown cock hackle"
    body-rear wool color=black
    middle cock-hackle color=brown fibre=1.6 sweep=45 label="Stiff brown cock hackle"
    body-front wool color=black
    front cock-hackle color=brown fibre=1.9 sweep=45 label="Stiff brown cock hackle, the longest"
}

steps {
    attach-thread at=0.88
    wrap-thread to=0.0
    tie-in butt
    wrap-thread to=0.1
    wind butt to=0.1 turns=4 note="A short red butt."
    tie-off butt
    tie-in rear
    wrap-thread to=0.15
    wind rear to=0.15 turns=3 note="Let the fibres splay out for bulk."
    tie-off rear
    tie-in body-rear
    wrap-thread to=0.5
    wind body-rear to=0.5 turns=7
    tie-off body-rear
    tie-in middle
    wrap-thread to=0.55
    wind middle to=0.55 turns=3
    tie-off middle
    tie-in body-front
    wrap-thread to=0.84
    wind body-front to=0.84 turns=6
    tie-off body-front
    tie-in front
    wrap-thread to=0.9
    // Assumption: hackles grow longer toward the front, as in the photos; no source gives sizes.
    wind front to=0.9 turns=3
    tie-off front
    whip-finish note="A small black head."
}
