// Stoat's Tail: the black hairwing salmon fly.

id stoats-tail
name "Stoat's Tail"
aliases "Stoats Tail" "Black Stoat"
type salmon
imitates attractor
difficulty intermediate
species salmon sea-trout
season may june july august september
origin region="Scotland"
description "An oval silver tag, a golden pheasant crest tail, a black floss body ribbed with oval silver, a black throat hackle and a low black hair wing."
history """
    Who tied it first is not documented; John Gray says only that it has been around a long
    time, though GlobalFlyFisher's video page gives James Wright as the pattern's author. The
    wing was originally hair from a stoat's tail; dyed black squirrel is the usual substitute.
    Hugh Falkus, as Gray quotes him, rated it "one of the best we have" for summer fishing with
    a floating line, and Sea Trout Nights counts it among the most popular sea-trout flies of
    modern times.
    """
fishing """
    A summer fly for a floating line, at its best in low, clear water and in the evening or
    other low light, and a good fly for grilse and for sea trout at night on rivers. It is tied
    on singles, doubles, trebles and tubes.
    """
sources {
    "Trout & Salmon Fishing: Stoat's Tail (John Gray)" url="https://trout-salmon-fishing.com/stoats-tail.htm"
    "GlobalFlyFisher: Stoat's Tail long wing (Ivar's Fly Workshop)" url="https://globalflyfisher.com/video/stoats-tail-long-wing"
    "Fish4Flies: Stoat's Tail" url="https://www.fish4flies.com/Salmon-Atlantic/Big-Mouth-Doubles/Stoats-Tail"
    "Sea Trout Nights: Flies and Fly Tying" url="https://seatrout-fishing.com/sea-trout-nights/flies-and-fly-tying/"
    "GlobalFlyFisher: Anatomy of a Salmon Fly (Steve Schweitzer)" url="https://globalflyfisher.com/node/13548"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://trout-salmon-fishing.com/stoats-tail.jpg" page="https://trout-salmon-fishing.com/stoats-tail.htm" author="John Gray" license="All rights reserved; reference only" note="Side view, single up-eye hook"
    "https://live.staticflickr.com/4084/4969440099_d1b754e2b5_b.jpg" page="https://www.flickr.com/photos/52179700@N00/4969440099" author="andrewb823" license="CC BY-NC 2.0" flip=#true note="Side view, on a double"
}

// Assumption: a single up-eye salmon hook; it is as often tied on doubles, trebles and tubes.
hook salmon-up-eye size=8
thread black size="8/0"

materials {
    tag oval-tinsel color=silver label="Fine oval silver tinsel"
    tail golden-pheasant-crest count=10
    rib oval-tinsel color=silver
    body silk-floss color=black
    throat hackle-fibres color=black count=24 label="Black cock hackle fibres"
    wing squirrel-tail color=black label="Stoat's tail or black squirrel"
}

steps {
    attach-thread at=0.86
    wrap-thread to=0.0
    tie-in tag
    wrap-thread to=0.06
    wind tag to=0.06 turns=4 note="A few close turns at the start of the bend."
    tie-off tag
    // About one and a half gapes, curving up: "Length is 1-1/2 of the hook gape" (Schweitzer,
    // Anatomy of a Salmon Fly).
    tie-in tail length=1.5 angle=14 spread=8
    tie-in rib
    tie-in body
    wrap-thread to=0.84
    wind body to=0.84 turns=12 note="Back to the tail and forward again: a smooth double layer, slightly tapered."
    tie-off body
    wind rib to=0.84 turns=5 note="Evenly spaced open turns."
    tie-off rib
    tie-in throat length=1.0 angle=30 side=under note="A little shorter than the wing; reaching about the hook point."
    // Gray's photo: the wing reaches about the tip of the tail.
    tie-in wing length=3.7 angle=8 spread=20 note="A small, cleaned bunch, low over the body."
    trim wing note="Butts cut at a taper for a small head."
    whip-finish note="Two or three coats of black varnish."
}
