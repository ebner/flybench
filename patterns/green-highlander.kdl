// Green Highlander: the classic yellow and green salmon fly, as a hairwing in Jim Misiura's dressing.

id green-highlander
name "Green Highlander"
type salmon
imitates attractor
difficulty intermediate
species salmon
description "An oval silver tag and yellow floss tip, a golden pheasant crest tail, a black ostrich butt, a body of yellow floss and green seal's fur ribbed with oval silver under a green hackle, a yellow throat, and a wing of tippet, mixed green and orange bucktail and red squirrel, with red golden pheasant cheeks."
history """
    The Highlander came first: Francis Francis (1867) lists it among the Ness flies he had from
    Snowie of Inverness, and calls it the best fly for the Carron. It already had the yellow rear
    and green front: gold floss nearly half up the body, then dirty olive-green mohair, ribbed with
    silver under a pea-green hackle, blue jay at the shoulder and a mixed wing with jungle cock and
    a topping. Kelson (1895) gives the Green Highlander and credits it to Grant: two turns of
    yellow silk and green seal's fur, a green hackle from the yellow, a yellow throat and a mixed
    wing under a topping. Pryce-Tannatt (1914) gives the dressing most classic tyers follow: the
    first quarter golden yellow floss, the rest bright green floss, a grass-green hackle, a lemon
    throat, and a wing of tippet and married swan, florican, peacock wing and golden pheasant tail
    with teal, summer duck and brown mallard, jungle cock, Indian crow and a topping. Today it is
    mostly tied with a hair wing, and the hairwings differ in the wing. This is Jim Misiura's: a
    tippet underwing, mixed green and orange bucktail, red squirrel over and red golden pheasant
    cheeks. Fly of the Month Club's has tippets, then yellow, orange and green bucktail, with a
    sparse brown bucktail over; Håkan Karsnäs's tube winds yellow, orange and warm brown fox in
    turn with the green and yellow hackles; and Ívar of Ívar's Fly Workshop says a grey or brown
    wing of squirrel, or even fox, is more common today.
    """
fishing """
    A fly for clear water, where it is still much used (Casper Hansen); Perfect Fly Store fishes
    it in low, clear water.
    """
sources {
    "Frosty Fly: Green Highlander Variation salmon fly (Jim Misiura)" url="https://frostyfly.com/fly-tying-a-green-highlander-variation-salmon-fly-with-jim-misiura/"
    "Internet Archive: A Book on Angling (Francis Francis, 1867)" url="https://archive.org/details/cu31924003429226"
    "Internet Archive: The Salmon Fly (George M. Kelson, 1895)" url="https://archive.org/details/salmonflyhowtodr00kelsrich"
    "Internet Archive: How to Dress Salmon Flies (T. E. Pryce-Tannatt, 1914)" url="https://archive.org/details/howtodresssalmon00prycrich"
    "Fly Tying Archive: Green Highlander from G. M. Kelson (Timo Kontio)" url="https://flytyingarchive.com/green-highlander-kelson-classic-salmon-fly/"
    "Ahrex Hooks: The Green Highlander (John Lind Rasmussen, Håkan Karsnäs)" url="https://ahrexhooks.com/2021/03/19/the-green-highlander/"
    "GlobalFlyFisher: Green Highlander (video, Ívar's Fly Workshop)" url="https://globalflyfisher.com/video/green-highlander-1"
    "GlobalFlyFisher: Green Highlander (video, Casper Hansen for Ahrex)" url="https://globalflyfisher.com/node/71449"
    "Fly of the Month Club: Green Highlander hairwing" url="http://www.flyofthemonthclub.com/store/catalog.asp?item=1411"
    "Perfect Fly Store: Green Highlander" url="https://perfectflystore.com/product/green-highlander/"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://frostyfly.com/cdn/shop/articles/Green-Highlander-Variation-Salmon-Fly_79c95c17-d49f-43c8-8a20-489b3c41d134.jpg?v=1761152528&width=1100" page="https://frostyfly.com/fly-tying-a-green-highlander-variation-salmon-fly-with-jim-misiura/" author="Jim Misiura" license="All rights reserved; reference only" flip=#true note="Misiura's fly, side view in the vise"
    "http://www.flyofthemonthclub.com/store/images/products/large/Highlender500.jpg" page="http://www.flyofthemonthclub.com/store/catalog.asp?item=1411" license="All rights reserved; reference only" note="A hairwing with a long yellow collar"
    "https://www.fish4flies.com/img/flies/Original/2621-Green%20Highlander%202030J%20(1).jpg" page="https://www.fish4flies.com/Salmon-Atlantic/Doubles/Green-Highlander" license="All rights reserved; reference only" note="A hairwing double, jungle cock"
    "https://perfectflystore.com/wp-content/uploads/2021/03/Green_Highlander.jpg" page="https://perfectflystore.com/product/green-highlander/" license="All rights reserved; reference only" flip=#true note="A hairwing in the vise"
}

// Misiura: a salmon hook, 1/0 to 8; his is a Maruto M30 #6.
hook salmon-up-eye size=6
thread black size="8/0"

materials {
    tag oval-tinsel color=silver label="Oval silver tinsel"
    yellow-tag silk-floss color=yellow label="Yellow floss"
    tail golden-pheasant-crest count=10
    butt ostrich-herl color=black strands=2
    rib oval-tinsel color=silver
    body-rear silk-floss color=yellow label="Yellow floss"
    // Misiura: or green Hemingway's Peacock dubbing.
    body seals-fur color=green label="Green seal's fur"
    // Read from Misiura's photo: soft fibres under a gape long, swept back, mostly hidden under the throat.
    hackle wet-fly-cock-hackle color=green fibre=0.8 sweep=65 label="Green cock hackle"
    throat hackle-fibres color=yellow count=60 label="Yellow cock hackle"
    underwing golden-pheasant-tippet count=20
    wing bucktail color=green mix=orange count=60 label="Mixed green and orange bucktail"
    overwing squirrel-tail color=red-brown count=50 label="Red squirrel tail"
    // Misiura: "red golden pheasant neck feathers".
    cheeks golden-pheasant-body label="Red golden pheasant neck feathers"
}

// Misiura lists the materials, not the steps: the order is the usual hairwing order (Thunder &
// Lightning, Garry Dog), with Kelson's layout of the hackle from the yellow.
steps {
    attach-thread at=0.86
    wrap-thread to=0.0 note="To opposite the barb."
    tie-in tag
    wrap-thread to=0.05
    wind tag to=0.05 turns=4
    tie-off tag
    tie-in yellow-tag
    wrap-thread to=0.12
    wind yellow-tag to=0.12 turns=7
    tie-off yellow-tag
    // Read from Misiura's photo: about 1.3 gapes, curving up.
    tie-in tail length=1.3 angle=12 spread=8
    tie-in butt
    wrap-thread to=0.17
    wind butt to=0.17 turns=3 note="Three turns, the flue stroked back."
    tie-off butt
    tie-in rib
    tie-in body-rear
    // Misiura: the rear third yellow floss, the front two thirds green seal's fur.
    wrap-thread to=0.39
    wind body-rear to=0.39 turns=12 note="Smooth, close turns."
    tie-off body-rear
    tie-in hackle note="By its tip, at the front of the yellow."
    dub body to=0.82 note="Seal's fur, fairly slim."
    // Assumption: palmered over the green part, as Kelson's "from the yellow".
    wind hackle to=0.82 turns=4 note="Open turns over the seal's fur."
    tie-off hackle
    wind rib to=0.82 turns=5 note="Five turns, close in front of the hackle stalk."
    tie-off rib
    // Assumption: Misiura's yellow hackle as a throat, a bunch of its fibres underneath (or a few
    // turns pulled down), as the classic throat is. Read from his photo: past the hook point.
    tie-in throat length=1.8 angle=22 side=under
    // Read from Misiura's photo: the wing reaching well past the tail, about four gapes.
    tie-in underwing length=2.4 angle=7 spread=14 note="A small bunch of tippet strands."
    tie-in wing length=4.0 angle=8 spread=18 note="The two colours mixed."
    trim wing
    tie-in overwing length=4.0 angle=9 spread=14 note="Sparse, over the bucktail."
    trim overwing note="Cut at an angle for a small head."
    tie-in cheeks length=0.9 angle=10 spread=30 note="One each side of the wing's root."
    whip-finish varnish=#true note="A black head, varnished."
}
