// Willie Gunn on a double hook, as Fish4Flies dresses it.

id willie-gunn-double
name "Willie Gunn"
variant-of willie-gunn
variant "On a double"
type salmon
difficulty beginner
species salmon sea-trout
season february march april may june july august september
origin region="Brora, Sutherland, Scotland"
description "An oval gold tag and rib over a black floss body, a short orange throat, and a long wing of yellow, orange and black bucktail."
history """
    Named after Willie Gunn, who worked for the Sutherland Estates as keeper and gillie, and
    linked in every account to Rob Wilson's tackle shop in Brora. Who designed it is disputed. The
    best-known story, told on GlobalFlyFisher and by John Gray, credits Flight Lieutenant "Dusty" Miller, who tied
    flies for Wilson; Gray dates it to the 1940s. Ross Macdonald gives the account of Gunn's nephew,
    Jim MacKenzie, who says he tied the first ones, with a blended wing, in March 1968. Gray
    describes the colours as those of the Thunder & Lightning. Fish4Flies says the first were tied
    on Waddington shanks, while Macdonald's telling of the Miller story speaks of tubes. Macdonald
    also thinks the gold-bodied version may now be more popular than the black.
    """
fishing """
    To Ross Macdonald it stands for spring fishing in Scotland, and it is tied in every size from
    small summer flies to the biggest tubes. Big Waddingtons and heavy tubes are for the cold, high
    water of early spring, fished deep; small, lightly dressed singles and doubles for low summer
    water. Swing it across and down. Changing the share of each colour suits it to dark or clear
    rivers.
    """
sources {
    "GlobalFlyFisher: Streamers365 #22-2013, Willie Gunn (Dan Despres)" url="https://globalflyfisher.com/node/67405"
    "Trout & Salmon Fishing: The Willie Gunn tube fly (John Gray)" url="https://trout-salmon-fishing.com/willie-gunn-tube-fly.htm"
    "Fly Fish 50: The Willie Gunn salmon fly (Ross Macdonald)" url="https://flyfish50.com/a-fly-to-try-this-month-willie-gunn/"
    "Fish4Flies: Willie Gunn double" url="http://www.fish4flies.com/Salmon-Atlantic/Doubles/Willie-Gunn"
    "Fish4Flies: Willie Gunn tube" url="https://www.fish4flies.com/Salmon-Atlantic/Tubes/Bottle-Brass/Willie-Gunn-Tube"
    "Fish4Flies: Willie Gunn Waddington" url="https://www.fish4flies.com/Salmon-Atlantic/Waddingtons/Willie-Gunn-Waddington"
    "Guide Fly Fishing: Caledonia Willie Gunn Nordic Single" url="https://guideflyfishing.co.uk/product/caledonia-willie-gunn-nordic-single"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://globalflyfisher.com/sites/default/files/streamers/2013/03/22_willie_gunn_dd.jpg" page="https://globalflyfisher.com/node/67405" author="Daniel Despres" license="All rights reserved; reference only" note="Single hooks, gold and silver versions"
    "https://www.fish4flies.com/img/flies/Large/2626-2626.jpg" page="http://www.fish4flies.com/Salmon-Atlantic/Doubles/Willie-Gunn" license="All rights reserved; reference only" flip=#true note="Classic black body, on a double"
}

// Assumption: a double up-eye hook, as the shops sell it; the original was a Waddington.
hook salmon-double size=8
thread black size="8/0"

materials {
    tag oval-tinsel color=gold label="Fine oval gold tinsel"
    rib oval-tinsel color=gold
    body silk-floss color=black
    // Assumption: Fish4Flies ties a mixed throat on its double; drawn here as orange alone.
    throat bucktail color=orange label="Orange bucktail (or mixed orange, yellow and black)"
    yellow bucktail color=yellow
    orange bucktail color=orange
    black bucktail color=black
}

steps {
    attach-thread at=0.86
    wrap-thread to=0.0
    tie-in tag
    wrap-thread to=0.06
    wind tag to=0.06 turns=4
    tie-off tag
    tie-in rib note="Under the shank."
    tie-in body
    wrap-thread to=0.84
    wind body to=0.84 turns=12 note="Back to the tag and forward again, slim and even."
    tie-off body
    wind rib to=0.84 turns=5
    tie-off rib
    tie-in throat length=0.9 angle=25 side=under note="Short, about halfway to the hook point."
    trim throat
    // Layered, which Macdonald says (after Stan Headley) was Rob Wilson's way; the original was blended.
    // Yellow under orange under black (GlobalFlyFisher, John Gray). Dressed long (Macdonald).
    tie-in yellow length=4.5 angle=2 spread=12 note="Equal parts of each colour."
    trim yellow
    tie-in orange length=4.5 angle=4 spread=12
    trim orange
    tie-in black length=4.5 angle=6 spread=14
    trim black note="Cut at an angle so the head tapers."
    whip-finish note="A small, neat black head."
}
