// Greenwell's Glory: the Tweed wet fly for olives, with a waxed yellow silk body, a coch-y-bonddu hackle and a dark quill wing.

id greenwells-glory
name "Greenwell's Glory"
aliases "Greenwell"
type wet
imitates mayfly
naturals mayfly-emerger
difficulty intermediate
species trout grayling
season march april may september
origin originator="James Wright for Canon William Greenwell" year=1854 region="Sprouston, River Tweed, Scotland"
description "A body of waxed yellow silk ribbed with fine gold wire, a coch-y-bonddu hen hackle and a dark blackbird or starling quill wing."
history """
    In May 1854 Canon William Greenwell of Durham had a blank day on the Tweed while the trout
    fed on a dun. He took one of the naturals to James Wright, the fly dresser at Sprouston near
    Kelso, who tied imitations; the Canon did so well with them the next day that the fly was
    named over a celebration at Wright's. The tellings differ in detail, and the 1854 date rests
    on later accounts. Late in life the Canon gave R. B. Marston of the Fishing Gazette his own
    dressing: "the wings, inside of a blackbird wing; body, red and black hackle; tied with
    yellow silk". Courtney Williams quotes another letter allowing gold thread "if wished", and
    by 1903 E. M. Tod ribbed the body with fine gold wire.
    """
fishing """
    A wet fly for the olives. Edmonds and Lee give it March to early May and again September,
    and keep it going through the summer months between with a lighter wing, body and hackle.
    On Scottish lochs it is one of the traditional flies for a cast of three or four fished
    from a drifting boat, and Alastair Gowans lists it among the wet flies for autumn grayling.
    """
sources {
    "Fly Anglers Online: Greenwell's Glory, Just Old Flies #106 (Deanna Birkholm, archived)" url="https://web.archive.org/web/20181229104611/http://flyanglersonline.com/features/oldflies/part106.php"
    "Fly Anglers Online: The Greenwell's Glory Tales (Alan Shepherd, archived)" url="https://web.archive.org/web/20181229111919/http://flyanglersonline.com/features/oldflies/part234.php"
    "Internet Archive: Brook and River Trouting (Edmonds & Lee, 1916)" url="https://archive.org/details/brookrivertrouti00edmorich"
    "SWTU: Greenwell's Glory, Tweed style (Rusty Dunn)" url="https://www.swtu.org/2018/02/08/greenwells-glory-tweed-style/"
    "Trout & Salmon Fishing: Trout Flies, Traditional Scottish Flies" url="https://www.trout-salmon-fishing.com/trout-flies.htm"
    "Let's Fly Fish: Grayling fly fishing (Alastair Gowans)" url="https://letsflyfish.com/graylingpage.htm"
    "Sexyloops: Greenwell's Glory (fly fishing glossary)" url="https://www.sexyloops.com/glossary/greenwell.shtml"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://i0.wp.com/www.swtu.org/wp-content/uploads/2018/02/Greenwells-Glory-975px.jpg" page="https://www.swtu.org/2018/02/08/greenwells-glory-tweed-style/" author="Rusty Dunn" license="All rights reserved; reference only" note="Side view in the vise, Tweed style"
    "https://web.archive.org/web/20170924073921im_/http://flyanglersonline.com/features/oldflies/greenwells.jpg" page="https://web.archive.org/web/2020/https://www.flyanglersonline.com/features/oldflies/part106.php" license="All rights reserved; reference only" note="Side view, low dark wing"
}

hook wet-standard size=14
// Assumption: waxing turns yellow silk a dingy greenish yellow; drawn in that colour.
thread "#a99a3a" size="8/0"

materials {
    rib gold-wire
    hackle hen-hackle color=coch fibre=0.8 sweep=60 label="Coch-y-bonddu or furnace hen hackle"
    wing starling-quill color="#3a3a3e" label="Blackbird or starling quill slips"
}

steps {
    attach-thread at=0.88
    wrap-thread to=0.0
    tie-in rib
    wrap-thread to=0.86 note="Close, even turns of the waxed silk make the body."
    wind rib to=0.86 turns=4 note="Four open turns (Edmonds & Lee)."
    tie-off rib
    // SWTU: hackle no longer than the hook point.
    tie-in hackle note="Hen hackle, shiny side forward."
    wrap-thread to=0.9
    wind hackle to=0.9 turns=3 note="Sparse; stroke the fibres down and back."
    tie-off hackle
    // Assumption: wing tips level with the bend or a little beyond (Gregg's general rule).
    tie-in wing length=2.0 angle=18 spread=12 width=0.5 note="Matching left and right slips, concave sides together, sloping back over the body."
    whip-finish note="A small head of the same silk."
}
