// Partridge & Orange: the classic North Country spider: orange silk body, partridge hackle.

id partridge-and-orange
name "Partridge & Orange"
aliases "Orange Partridge" "Partridge and Orange"
type wet
imitates mayfly caddis
naturals caddis-pupa mayfly-emerger mayfly-spinner stonefly-adult
difficulty beginner
species trout grayling
season april may june july august september
origin region="North of England"
description "A short, slim body of orange silk, optionally ribbed with gold wire, and one or two turns of mottled brown partridge."
history """
    A North Country spider from the Yorkshire Dales. The earliest dressing found is Pritt's
    "Orange Partridge" in Yorkshire Trout Flies (1885), a body of orange silk and a well
    dappled feather from a partridge's back; Pritt fished it from April to September on warm
    days. Wikipedia says the style was first described by Joseph Wells in 1842, but gives
    no source. Edmonds and Lee (1916) ask for a mottled, not barred, feather. Sylvester
    Nemes' The Soft-Hackled Fly (1975) popularised soft-hackled flies like it in America.
    """
fishing """
    Fished across and down on a team of two or three spiders, or upstream on a short line,
    just under the surface: the soft partridge fibres move with the slightest current and
    suggest a hatching nymph or pupa.
    """
sources {
    "T. E. Pritt: Yorkshire Trout Flies (1885)" url="https://archive.org/details/yorkshiretroutfl00pritrich"
    "Edmonds & Lee, Brook and River Trouting (1916)" url="https://archive.org/details/brookrivertrouti00edmorich"
    "Sexyloops: North Country Spiders part 2 (Ben Spinks)" url="https://www.sexyloops.com/flytying/northcountrywets2.shtml"
    "Hawker-Overend: Spider flies, how to fish these old classics (Andrew Overend)" url="https://hawker-overend.com/how-to-tie-and-fish-north-country-spider-flies/"
    "Wikipedia: Partridge and Orange" url="https://en.wikipedia.org/wiki/Partridge_and_Orange"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://upload.wikimedia.org/wikipedia/commons/2/2c/PartridgeandOrange.jpg" page="https://commons.wikimedia.org/wiki/File:PartridgeandOrange.jpg" author="Mike Cline" license="Public domain" note="Side view, gold wire rib"
    "https://hawker-overend.com/wp-content/uploads/2020/12/Partridge-and-Orange-spider-flies-450w.jpg" page="https://hawker-overend.com/how-to-tie-and-fish-north-country-spider-flies/" license="All rights reserved; reference only" note="Side view"
    "https://www.sexyloops.com/flytying/ncspiders/partridge%20and%20orange.jpg" page="https://www.sexyloops.com/flytying/northcountrywets2.shtml" author="Ben Spinks" license="All rights reserved; reference only" flip=#true note="Side view"
}

hook wet-standard size=14
thread orange size="8/0"

materials {
    rib gold-wire
    // Spinks: barbs from the back of the eye to just past the bend.
    hackle partridge-hackle fibre=1.8 label="Brown partridge (back or neck feather)"
}

steps {
    attach-thread at=0.88
    // Edmonds & Lee: keep the body short, ending no further back than halfway between hook point and barb.
    wrap-thread to=0.35 note="Touching turns, to above the hook point."
    tie-in rib note="Optional; the classic dressing has none."
    wrap-thread to=0.86 note="A slim, single-layer silk body; don't build a taper."
    wind rib to=0.86 turns=4
    tie-off rib
    tie-in hackle note="By the tip, just behind the eye, fluff stripped and barbs stroked out."
    wrap-thread to=0.93
    wind hackle to=0.93 turns=2 note="One or two turns, stroking the barbs back after each."
    tie-off hackle
    whip-finish note="A small orange head."
}
