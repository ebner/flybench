// Butcher: a classic English winged wet fly: red tail, silver body, black throat, blue-black wing.

id butcher
name "Butcher"
aliases "Moon's Fly"
type wet
// Only retail copy calls it a fish imitation: Dennett "a small pin-finned fish or a beetle",
// Fish4Flies "small baitfish" (of the Bloody Butcher). Dennett also calls it an attractor.
imitates baitfish attractor
difficulty advanced
species trout sea-trout
season april may june july august september
origin originator="Jewhurst and Moon" year=1838 region="Kent, England"
description "A red tail, a flat silver tinsel body with a wire rib, a black hackle throat and paired blue-black mallard wing slips."
history """
    First called Moon's Fly. Smedley (Fly Patterns and Their Origins) says it came from John
    Jewhurst of Tunbridge, Kent, and that William Blacker renamed it about 1838 after the
    trade of Mr Moon, a butcher who favoured it. Other accounts make Moon and
    Jewhurst joint inventors, place them in Tunbridge Wells, or give 1836. The colours as
    blood, blade and apron are a popular story; Timo Kontio calls it a theory.
    """
fishing """
    A winged wet fly for rivers and still waters. Global FlyFisher's video puts its close
    relative, the Bloody Butcher, on a middle dropper or the point of a team of wets, on
    lochs and lakes as well as rivers, and ties it bigger for sea trout, even as a streamer. Fly sellers describe its silver body
    and dark wing as suggesting a small fish.
    """
sources {
    "Fly Anglers Online: Butcher, Just Old Flies (Deanna Birkholm, archived)" url="https://web.archive.org/web/20181229112130/http://flyanglersonline.com/features/oldflies/part276.php"
    "Fly Tying Archive: Butcher (Timo Kontio)" url="https://flytyingarchive.com/butcher/"
    "GlobalFlyFisher: Bloody Butcher" url="https://globalflyfisher.com/video/bloody-butcher"
    "Fish4Flies: Butcher" url="https://www.fish4flies.com/Wet/Winged/Butcher"
    "Fish4Flies: Bloody Butcher" url="https://www.fish4flies.com/Wet/Winged/Bloody-Butcher"
    "Dennett Outdoors: Dragon wet fly selection pack 1" url="https://denod-dennettoutdoors.dc02.gob2b.com/Catalogue/Flies/Trout-Flies/Dragon-Fly-Selection-Packs/Dragon-Fly-Packs-Wet-Fly-1-FZGDR079"
    "Project Gutenberg: How to Tie Flies (E. C. Gregg, 1940)" url="https://www.gutenberg.org/ebooks/30292"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://flytyingarchive.com/wp-content/uploads/2015/01/tumblr_ni9q4nhq2J1qg8e5ko2_1280.jpg" page="https://flytyingarchive.com/butcher/" author="Timo Kontio" license="All rights reserved; reference only" note="Side view in the vise"
    "https://www.fish4flies.com/img/flies/Large/865-865%20Butcher.jpg" page="https://www.fish4flies.com/Wet/Winged/Butcher" license="All rights reserved; reference only" flip=#true note="Side view"
}

hook wet-standard size=12
thread black size="8/0"

materials {
    tail duck-quill color=red label="Red-dyed duck quill slip"
    rib silver-wire
    body flat-tinsel color=silver
    throat hackle-fibres color=black count=12 label="Black hen hackle fibres"
    wing duck-quill color=blue-black label="Blue-black mallard secondary slips"
}

steps {
    attach-thread at=0.9
    wrap-thread to=0.0
    // Assumption: a tail about half the shank, as in the reference photos.
    tie-in tail length=1.1 angle=8 width=0.18 note="A narrow slip, on top at the bend."
    tie-in rib
    tie-in body
    wrap-thread to=0.88
    wind body to=0.88 turns=14 note="Touching turns, smooth and untapered."
    tie-off body
    wind rib to=0.88 turns=5
    tie-off rib
    tie-in throat length=0.9 angle=35 side=under note="Reaching about to the hook point."
    // Gregg (1940): wing tips even with the bend or a little beyond.
    tie-in wing length=2.0 angle=10 spread=12 width=0.45 note="Matching left and right slips, concave sides together, set on top with a pinch-and-loop."
    whip-finish note="A smooth, tapered black head."
}
