// CDC & Elk: Hans Weilenmann's caddis: one CDC feather wound as body and hackle, under a deer hair wing.

id cdc-and-elk
name "CDC & Elk"
aliases "CDC and Elk"
type dry
imitates caddis
naturals caddis-adult mayfly-emerger
difficulty intermediate
species trout
season may june july august september
origin originator="Hans Weilenmann" year=1992 region="Netherlands"
description "A single CDC feather wound from the tip to make body and soft hackle, and a fine deer hair wing whose square-cut butts form the head."
history """
    The Dutch tyer Hans Weilenmann designed it in 1992 as a reworking of Al Troth's Elk Hair
    Caddis, which had been one of his most reliable dry flies since a trip to Montana in 1982.
    Looking for a fly that floated better and moved more, he replaced the dubbed body and
    palmered hackle with one whole CDC feather, stem and all. Despite the name, he ties the
    wing with fine-tipped deer hair.
    """
fishing """
    A low-riding caddis that Weilenmann also uses during many mayfly hatches, as a searching
    fly when nothing is hatching, as an emerger, and even wet. Greased with floatant it rides
    higher; left untreated, the CDC soaks up water and it fishes as an emerger or cripple. Use
    less hair in the wing for smooth water and more for broken water.
    """
sources {
    "GlobalFlyFisher: CDC & Elk (Hans Weilenmann)" url="https://globalflyfisher.com/node/13606"
    "GlobalFlyFisher: Tying with CDC (Hans Weilenmann)" url="https://globalflyfisher.com/tie-better/tying-cdc"
    "GlobalFlyFisher: The CDC & Elk family (Martin Joergensen)" url="https://globalflyfisher.com/node/14532"
    "Charlie's Fly Box: CDC & Elk" url="https://charliesflybox.com/blogs/step-by-step-tutorials/cdc-elk"
    "Rogue Fly Fishers: CDC & Elk (Dan Kellogg)" url="https://rogueflyfishers.org/?p=494"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://globalflyfisher.com/sites/default/files/article_pictures/hw-cdcelk.jpg" page="https://globalflyfisher.com/node/13606" author="Hans Weilenmann" license="All rights reserved; reference only" note="Side view in the vise"
    "https://cdn.shopify.com/s/files/1/0569/0877/5562/files/DSCN8917.jpg?v=1644427774" page="https://charliesflybox.com/blogs/step-by-step-tutorials/cdc-elk" license="All rights reserved; reference only" flip=#true note="Side view in the vise"
    "https://rogueflyfishers.org/wp-content/uploads/2026/03/cdcelk.jpg" page="https://rogueflyfishers.org/?p=494" license="All rights reserved; reference only" note="Side view in the vise"
}

// Assumption: The CDC body lies in the film, its fibres spread on the surface (Weilenmann's
// photo on the water).
sits body
hook dry-standard size=14
thread brown size="8/0"

materials {
    // Weilenmann picks a feather whose longest barbs are about twice the shank (GFF; Rogue).
    // In the reference photos the front barbs trail back along and under the body to about a
    // gape past the bend, sparse and wispy: about 2.5 gapes long, leaning well back.
    body cdc label="Natural dun CDC feather (one, wound)" fibre=2.5 sweep=70
    wing deer-hair label="Fine-tipped deer hair"
}

steps {
    attach-thread at=0.5
    wrap-thread to=0.0
    tie-in body note="By its tip, the tip barbs stroked together."
    wrap-thread to=0.78 note="Then one turn back."
    wind body to=0.78 turns=7 note="Touching turns, stroking the barbs back after each; the rear turns make the body, the front ones a soft collar."
    tie-off body
    // Sources: wing tips to the outside of the bend. The reference photos show it rising
    // steeply, about 30° (the reviewer's choice, 2026-10-29).
    tie-in wing length=2.15 angle=30 spread=70 note="Stacked; butts trimmed square first so they end just behind the eye."
    trim wing leave=0.15 note="Short flared stubs make the head."
    whip-finish note="In front of the butts, under the stubs."
}
