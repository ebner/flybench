// Cat's Whisker: David Train's white marabou and lime chenille stillwater lure with bead-chain eyes.

id cats-whisker
name "Cat's Whisker"
aliases "Cats Whisker"
type streamer
imitates baitfish
difficulty beginner
species trout
season january february march april may june july august september october november december
origin originator="David Train" region="England, 1980s"
description "A white marabou tail and wing, a fluorescent lime chenille body with a silver wire rib, and silver bead-chain eyes behind the eye."
history """
    David Train's lure from the 1980s; Funky Fly Tying says the early 1980s, the GlobalFlyFisher
    video about 1985. The first version had no eyes, and to keep the marabou from fouling round
    the hook Train tied in four white whiskers his cat had shed. Adding bead-chain eyes, to make
    it sink and swim level, did away with the whiskers, but not the name. Train sent some to
    Bob Church, who won competitions with them, and it became one of the best known British
    stillwater lures.
    """
fishing """
    A weighted stillwater lure, fished on whatever line puts it at the trout's depth, from
    floating to fast-sinking. Strip it in long, uneven pulls and break the rhythm now and then
    with a pause and a few quick, short jerks. When it stops, the eyes tip its head down; when
    it moves, it darts up again like a fleeing fry, and the marabou keeps moving throughout.
    It fishes all year. The English Fly Fishing Shop rates it highest in autumn, when trout
    feed on the year's fry; Funky Fly Tying prefers it in cold water, from late October to
    April.
    """
sources {
    "English Fly Fishing Shop: White and Orange Cats Whisker Streamer (Craig Moore)" url="http://english-fly-fishing-flies.s3-website-eu-west-1.amazonaws.com/catswhisker-whiteandpink.htm"
    "English Fly Fishing Shop: The White and Green Cat's Whisker (Craig Moore)" url="http://english-fly-fishing-flies.s3-website-eu-west-1.amazonaws.com/catswhisker-whiteandgreen.htm"
    "Troutflies UK Blog: Cats Whisker (Wendy)" url="https://www.troutflies.co.uk/blog/useful-tying-patterns/cats-whisker/"
    "Funky Fly Tying: The Cat's Whisker, step by step" url="https://funkyflytying.com/?p=62048"
    "GlobalFlyFisher: Cat's Whisker (video, Ívar's Fly Workshop)" url="https://globalflyfisher.com/video/cats-whisker"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "http://english-fly-fishing-flies.s3-website-eu-west-1.amazonaws.com/catswhisker-whiteandgreen.jpg" page="http://english-fly-fishing-flies.s3-website-eu-west-1.amazonaws.com/catswhisker-whiteandgreen.htm" author="Craig Moore" license="Free reuse with a link back" note="Side view, lying flat"
    "https://www.fish4flies.com/img/flies/Large/2447-2447.jpg" page="https://www.fish4flies.com/Lures/Beaded-Specials/Cats-Whisker" license="All rights reserved; reference only" flip=#true note="Side view"
}

// Assumption: a 2X long lure hook; sources range from standard to 3X long.
hook nymph-2xl size=10
thread black size="8/0"

materials {
    eyes bead-chain-eyes mm=3
    tail marabou color=white
    rib silver-wire
    body chenille color=chartreuse label="Fluorescent lime chenille"
    wing marabou color=white
}

steps {
    attach-thread at=0.92
    tie-in eyes note="On top, just behind the eye, with figure-of-eight turns."
    wrap-thread to=0.0
    // Observed in photos: the tail runs about a shank length past the bend.
    tie-in tail length=2.6 spread=20 note="A large pinch; tear it to length, never cut it."
    tie-in rib
    tie-in body note="Above the wire."
    wrap-thread to=0.86
    wind body to=0.86 turns=12 note="Touching turns, stopping short of the eyes."
    tie-off body
    wind rib to=0.86 turns=5 counter=#true
    tie-off rib
    tie-in wing length=5.0 angle=10 spread=20 note="A second large pinch, reaching about the tail tip."
    wrap-thread to=0.97 note="Past the eyes, crossing between them."
    whip-finish note="A small head in front of the eyes, varnished."
}
