// F-Fly: Marjan Fratnik's two-material CDC caddis from Slovenia.

id f-fly
name "F-Fly"
aliases "Fratnik Fly"
type dry
imitates caddis
difficulty beginner
species trout grayling
season may june july august september
origin originator="Marjan Fratnik" year=1980 region="Soča, Slovenia"
description "A body of tying thread and a wing of natural dun CDC, cut to length."
history """
    Designed by Marjan Fratnik of the Soča valley as a caddis imitation: in 1980 according to
    Hans Weilenmann, or from a CDC fly Swiss tyer Jules Rindlisbacher gave him in 1983
    according to his obituary. The original had no body material at all, just silk thread,
    and its wing was cut to length so the cut end would dry quickly.
    """
fishing """
    Sits low and very naturally in the film, as caddis and small mayflies and as a general
    searching fly. Fish it dead drift; after a fish, dry the CDC with amadou or a powder
    rather than paste floatant.
    """
sources {
    "GlobalFlyFisher: Tying with CDC (Hans Weilenmann)" url="https://globalflyfisher.com/patterns/f-fly"
    "Forelle & Äsche: Marjan Fratnik obituary" url="https://www.forelleundaesche.com/2012/09/marjan-fratnik/"
    "Midcurrent: F-Fly (Tim Flagler)" url="https://midcurrent.com/flies/f-fly/"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://globalflyfisher.com/sites/default/files/imported_pictures/f_fly.jpg" page="https://globalflyfisher.com/picture/the-f-fly" license="All rights reserved; reference only" note="Side view in the vise, thread body"
    "https://www.forelleundaesche.com/wp-content/uploads/2012/09/Fliegenbinden-F-Fly-4.jpg" page="https://www.forelleundaesche.com/2012/09/marjan-fratnik/" license="All rights reserved; reference only" note="Side view, yellow dubbed body"
    "https://www.czechnymph.com/data/web/gallery/tying/f-fly/f-fly-12.jpg" page="https://www.czechnymph.com/en/fly-fishing-picture-gallery/fly-tying/32-fly-tying-f-fly" license="All rights reserved; reference only" note="Side view in the vise"
}

hook dry-standard size=16
thread black size="8/0"

materials {
    wing cdc label="Natural dun CDC feathers, two stacked"
}

steps {
    attach-thread at=0.9
    wrap-thread to=0.0
    wrap-thread to=0.88 note="A thin, even thread body: the original has no other body material."
    // Sources: the wing tips reach the back edge of the bend.
    tie-in wing length=2.35 angle=20 spread=45 note="Stacked with tips and curves matched; pinch-wrapped on top just behind the eye."
    whip-finish note="Trim the butts short, then cut the wing to length."
}
