// Pheasant Tail Nymph: Frank Sawyer's original, tied with copper wire and pheasant tail only.

id pheasant-tail-nymph
name "Pheasant Tail Nymph"
aliases "PTN" "Sawyer's Pheasant Tail" "Sawyer Nymph"
type nymph
imitates mayfly
difficulty beginner
species trout grayling
season march april may june july august september october
origin originator="Frank Sawyer" year=1958 region="River Avon, Wiltshire, England"
description "Four pheasant tail fibres and fine copper wire, with no thread: a short tail, a slim body, a wire thorax hump and a double wing case."
history """
    Frank Sawyer was a river keeper on the Wiltshire Avon from 1925 until he died on its banks at
    Netheravon in 1980, from 1928 for the Officers' (later Services Dry Fly) Fishing
    Association. He saw that olive nymphs swim with their legs tucked in, so his nymph has no
    hackle, and he tied it with fine copper wire in place of silk, which also gives it weight;
    Sporting Road says the wire came from a relay coil. The fly was published in Nymphs and the
    Trout in 1958; when he first tied it is less certain: Sporting Road dates the method to the
    1930s, Fly Fishing the Sierra the fly to the 1950s. He often tied it on the river bank,
    without a vise.
    """
fishing """
    Made for clear chalk streams, where the trout can be seen: cast well upstream of the fish,
    let the nymph sink to its depth, and as it comes near, lift the rod gently so the nymph
    swims up in front of it: Sawyer's induced take. It also catches fish on lakes,
    worked slowly below the surface.
    """
sources {
    "Wikipedia: Pheasant Tail Nymph" url="https://en.wikipedia.org/wiki/Pheasant_Tail_Nymph"
    "Wikipedia: Frank Sawyer (writer)" url="https://en.wikipedia.org/wiki/Frank_Sawyer_(writer)"
    "Sporting Road: Frank Sawyer's Pheasant Tail" url="https://sportingroad.com/2019/02/12/frank-sawyers-pheasant-tail/"
    "Fly Fishing the Sierra: Pheasant Tail Nymph" url="https://flyfishingthesierra.com/pheasant-tail-nymph/"
    "Fly Anglers Online: Frank Sawyer PT nymph, tying steps (Hans Weilenmann)" url="https://www.flyanglersonline.com/t/frank-sawyer-pt-nymph/15310"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://flyfishingthesierra.com/images/ptn/ptn11.jpg" page="https://flyfishingthesierra.com/pheasant-tail-nymph/" license="All rights reserved; reference only" note="Side view, wire-only original"
    "https://sportingroad.com/wp-content/uploads/2019/04/IMG_9504-1024x768.jpeg" page="https://sportingroad.com/2019/02/12/frank-sawyers-pheasant-tail/" license="All rights reserved; reference only" note="Side view in the vise"
}

// Assumption: a 1X-long nymph hook, drawn as a standard wet hook; Sawyer used old Redditch sizes 00 to 1.
hook wet-standard size=16
// Assumption: there is no thread. The fine copper wire does its job and is shown as copper thread.
thread copper size="8/0"

materials {
    hump copper-wire mm=0.1 label="Fine red copper wire"
    fibres pheasant-tail count=4 label="Cock pheasant centre tail fibres"
    case pheasant-tail count=4 label="Pheasant tail fibres (the butts, folded over)"
}

steps {
    weight hump from=0.5 to=0.85 note="Three or four overlapping layers just in front of the middle of the shank."
    attach-thread at=0.9 note="The same wire: wind it back over the shank to the bend."
    wrap-thread to=0.0
    // Sources keep it short: an eighth of an inch (Sporting Road, Fly Fishing the Sierra) or a quarter to a third
    // of the body (Weilenmann); this follows the reference photos.
    tie-in fibres length=0.9 spread=25 note="Tips first, under two turns of wire. Pheasant tail cuts easily, so go gently."
    // Assumption: Sawyer folds the same butts back and forward over the thorax for the wing
    // case; drawn as a second bunch tied in behind the thorax before the body is wound.
    wrap-thread to=0.52
    tie-in case note="Lying back over the tail for now."
    wrap-thread to=0.9 note="In Sawyer's method the wire is twisted round the fibres and wound with them."
    wind fibres to=0.9 turns=12 note="Touching turns over the abdomen and thorax."
    tie-off fibres
    pull-over case to=0.9 note="Over the thorax, then back and forward again: a double, darker wing case."
    whip-finish note="A few turns of wire behind the eye; break off the excess."
}
