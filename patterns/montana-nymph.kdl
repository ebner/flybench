// Montana Nymph: the black and yellow stonefly nymph, also popular on stillwaters.

id montana-nymph
name "Montana Nymph"
aliases "Montana Stone" "Montana"
type nymph
imitates stonefly damselfly
difficulty beginner
species trout bass
season january february march april may june july august september october november december
origin region="USA"
description "A black tail and chenille body, a yellow chenille thorax with a black hackle wound through it, and a black chenille wing case."
history """
    An old American pattern meant to imitate large stonefly nymphs. Ahrex, Peter Driver and
    JustGone.Fishing say it was first tied by Lew Oatman of New York, but none gives a date
    or a primary source. The dressing has changed over time and is tied in many colours;
    black and yellow is the classic. Today it is also widely fished on stillwaters
    for rainbow trout, and in Scandinavia it is fished in lakes as a damsel and dragonfly nymph.
    """
fishing """
    In rivers, dead drift it as a stonefly nymph, or cast it across heavy water on the point
    and let the current swing it down into calmer water. On lakes, fish it on a sinking line
    with a very slow retrieve, or on an intermediate line along the shore. It is also a
    searching pattern, and Guideline rates it for late evening and night fishing.
    """
sources {
    "Fly Anglers Online: Beginners' fly tying, part 13 (Al Campbell)" url="https://web.archive.org/web/20151128010940/http://www.flyanglersonline.com/flytying/beginners/part13.php"
    "Guideline: Montana Stone" url="https://www.guidelineflyfish.com/en/montana-stone-6"
    "GlobalFlyFisher: Montana Nymph (Ahrex, tied by Håkan Karsnäser)" url="https://globalflyfisher.com/video/montana-nymph-2"
    "GlobalFlyFisher: Montana Nymph (Michael Jensen)" url="https://globalflyfisher.com/video/montana-nymph-1"
    "Piscari-Fly: Montana nymphs and streamer (Peter Driver)" url="http://peterdriver.blogspot.com/2014/01/montana-nymphs-streamer.html"
    "JustGone.Fishing: Tying Montana Nymph (Hans)" url="https://justgone.fishing/2022/05/18/tying-montana-nymph/"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://guideline-products-production.imgix.net/images/773_ed65a19707-103099-full.jpg?q=70&fit=clip&w=1920&fm=jpg&auto=compress,format" page="https://www.guidelineflyfish.com/en/montana-stone-6" license="All rights reserved; reference only" note="Side view"
    "https://cdn11.bigcommerce.com/s-5020eou/images/stencil/1280x1280/products/1604/9325/015_768_side__92456.1615821021.png?c=2" page="https://riverbum.com/montana-nymph/" license="All rights reserved; reference only" flip=#true note="Side view, slightly from above"
    "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEjfEuRiK522CpulUK8PMe1hUkUdSmjk1qwIVUlWmCjL2uGGL8g73jIc6bDp3t8lBuv123uO0VO45tO7jQuO8-nBsdF6Oj6Y2tPXe31q-wONFlj4uV_6HRhUwQD_Q43IiRUXQs-rrYc2wFNd/s1600/montana+3+001.jpg" author="Peter Driver" license="All rights reserved; reference only" note="Side view in the vise, sunburst thorax"
}

hook nymph-2xl size=10
thread black size="6/0"

materials {
    tail hackle-fibres color=black count=12 label="Black hackle fibres"
    body chenille color=black
    case chenille color=black label="Black chenille (wing case)"
    hackle hen-hackle color=black fibre=0.9
    thorax chenille color=yellow
}

steps {
    attach-thread at=0.9
    wrap-thread to=0.0
    // Sources give a tail half to two thirds of the shank.
    tie-in tail length=1.5
    tie-in body
    wrap-thread to=0.55
    wind body to=0.55 turns=7 note="A little more than half the shank."
    tie-off body
    tie-in case note="On top, lying back over the body."
    tie-in hackle note="Soft hackle, curved side down, tight against the body."
    tie-in thorax
    wrap-thread to=0.88
    wind thorax to=0.88 turns=4
    tie-off thorax
    wind hackle to=0.88 turns=3 note="Open turns through the thorax, fibres sloping back."
    tie-off hackle
    pull-over case to=0.88 note="Over the top of the thorax, pushing the hackle down to the sides."
    whip-finish
}
