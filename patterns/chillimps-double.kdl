// Chillimps on a double hook, the way it is most often sold.

id chillimps-double
name "Chillimps"
variant-of chillimps
variant "On a double"
aliases "Chilimps"
type salmon
imitates crustacean attractor
difficulty beginner
species salmon sea-trout
season april may june july august september
origin originator="Rolf Vilhelmsson" year=1942 region="River Mörrum, Sweden"
description "Orange hackle-tip tail, a slim orange body ribbed with oval gold, an orange palmer hackle and a slightly longer orange front hackle."
history """
    Tied by Rolf Vilhelmsson at the Valhalla inn by the Mörrum in the early 1940s, with Olle
    Törnblom and Sven Hallman looking on; Törnblom later improved it. He wanted a strong colour
    for the clear but tea-stained river. The name is said to be whisky-blurred English for the
    colour of a shrimp, made worse by a barely legible last letter in the fishing journal.
    By 1969, when ABU sold an Optic version with bead eyes, it was already a Mörrum legend.
    """
fishing """
    Swung across and down like any salmon wet fly, on a floating or intermediate line. The
    palmered orange hackle gives plenty of life. Small versions on fine wet hooks are a Danish
    coastal fly for sea trout and garfish in the cold months. Often tied on doubles.
    """
sources {
    "Ahrex: Chillimps (Lars Chr. Bentsen)" url="https://ahrexhooks.com/2021/11/26/chillimps/"
    "GlobalFlyFisher: Chillimps" url="https://globalflyfisher.com/patterns/chillimps"
    "GlobalFlyFisher: Abu Optic Chillimps" url="https://globalflyfisher.com/video/abu-optic-chillimps"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://ahrexhooks.com/wp-content/uploads/2021/11/Chillimps_1-1024x682.jpg" page="https://ahrexhooks.com/2021/11/26/chillimps/" author="Lars Chr. Bentsen" license="All rights reserved; reference only" note="Side view on a single salmon hook"
}

// Assumption: "orange" here is the deep red-orange of the Ahrex photo.
hook salmon-double size=8
thread "#c8401a" size="6/0"

materials {
    tail hackle-tips color="#c8401a" label="Orange hackle tips"
    rib oval-tinsel color=gold
    palmer cock-hackle color="#c8401a" fibre=1.5 sweep=45 label="Orange cock hackle"
    front cock-hackle color="#c8401a" fibre=1.9 sweep=50 label="Orange cock hackle, a little longer"
}

steps {
    attach-thread at=0.86
    wrap-thread to=0.0
    // GFF: two thirds of the hook length.
    tie-in tail length=1.7 angle=8 spread=12 width=0.22 note="Two hackle tips, on top."
    tie-in rib note="Under the shank."
    tie-in palmer
    // Assumption: Ahrex lists no body; its photo shows a slim orange one, so the thread forms it.
    wrap-thread to=0.84 note="A slim, even thread body."
    wind palmer to=0.84 turns=6 note="Open turns."
    tie-off palmer
    wind rib to=0.84 turns=5 note="Counter-wound through the hackle, to protect the stem."
    tie-off rib
    tie-in front
    wrap-thread to=0.9
    wind front to=0.9 turns=3 note="Stroke the fibres back."
    tie-off front
    whip-finish note="A small, neat head; varnish it."
}
