// Chillimps on a double hook, which Ahrex suggests as an alternative to the single.

id chillimps-double
name "Chillimps"
variant-of chillimps
variant "On a double"
aliases "Chilimps"
type salmon
imitates crustacean
difficulty beginner
species salmon sea-trout
season april may june july august september
origin originator="Rolf Vilhelmsson" year=1942 region="River Mörrum, Sweden"
description "Orange hackle-tip tail, a slim orange body ribbed with oval gold, an orange palmer hackle and a slightly longer orange front hackle."
history """
    Tied by Rolf Vilhelmsson (Ahrex and Michael Jensen spell it Vilhelmson) at the Valhalla inn
    by the Mörrum: in 1942 according to Ahrex, in the early 1940s according to a reader's account
    on GlobalFlyFisher. That account has Olle
    Törnblom and Sven Hallman there to see it, and Törnblom refining it later; Michael Jensen names
    all three as its makers. Vilhelmsson chose a strong colour because the river, clear as it is,
    is always tinged brown. The name stories are anecdote: one says it was meant to name the colour
    of a shrimp and came out as pidgin English after a whisky or two, with the spelling fixed by a
    hard-to-read last letter in the fishing journal. ABU brought out a version with Optic eyes
    in 1969, by which time the plain fly was famous on the Mörrum.
    """
fishing """
    A salmon and sea-trout fly, fished like any wet fly for salmon. Ahrex also ties it on doubles.
    In small sizes on wet-fly hooks it is a Danish coastal fly for garfish (Martin Joergensen), and
    Ahrex suggests the same dressing on a saltwater hook for the cold season in the sea.
    """
sources {
    "Ahrex: Chillimps (Lars Chr. Bentsen)" url="https://ahrexhooks.com/2021/11/26/chillimps/"
    "GlobalFlyFisher: Chillimps (Martin Joergensen, with a reader's note on its origin)" url="https://globalflyfisher.com/patterns/chillimps"
    "GlobalFlyFisher: ABU Optic Chillimps (Michael Jensen)" url="https://globalflyfisher.com/video/abu-optic-chillimps"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://ahrexhooks.com/wp-content/uploads/2021/11/Chillimps_1-1024x682.jpg" page="https://ahrexhooks.com/2021/11/26/chillimps/" author="Lars Chr. Bentsen" license="All rights reserved; reference only" note="Side view on a single salmon hook"
}

// Assumption: "orange" here is the deep red-orange of the Ahrex photo.
hook salmon-double size=8
thread "#c8401a" size="6/0"

materials {
    tail hackle-tips color="#c8401a" label="Orange hackle tips"
    rib oval-tinsel color=gold
    palmer cock-hackle color="#c8401a" fibre=1.5 sweep=45 label="Orange cock hackle"
    front cock-hackle color="#c8401a" fibre=1.9 sweep=50 label="Orange cock hackle, a little longer"
}

steps {
    attach-thread at=0.86
    wrap-thread to=0.0
    // GFF: two thirds of the hook length.
    tie-in tail length=1.7 angle=8 spread=12 width=0.22 note="Two hackle tips, on top."
    tie-in rib note="Under the shank."
    tie-in palmer
    // Assumption: Ahrex lists no body; its photo shows a slim orange one, so the thread forms it.
    wrap-thread to=0.84 note="A slim, even thread body."
    wind palmer to=0.84 turns=6 note="Open turns."
    tie-off palmer
    wind rib to=0.84 turns=5 counter=#true note="Through the hackle, to protect the stem."
    tie-off rib
    tie-in front
    wrap-thread to=0.9
    wind front to=0.9 turns=3 note="Stroke the fibres back."
    tie-off front
    whip-finish note="A small, neat head; varnish it."
}
