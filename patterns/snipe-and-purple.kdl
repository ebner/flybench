// Snipe & Purple: a North Country spider: purple silk and a dark snipe covert.

id snipe-and-purple
name "Snipe & Purple"
aliases "Dark Snipe" "Snipe and Purple"
type wet
imitates mayfly
difficulty beginner
species trout grayling
season march april may september october
origin region="North of England"
description "A short body of purple silk and one or two turns of a dark grey snipe covert feather."
history """
    A Yorkshire and Lancashire Dales spider. Pritt gave it as the "Dark Snipe" in Yorkshire
    Trout Flies (1885), a killer "on very cold days in the early part of the season, and a
    favourite on the Ribble"; Edmonds and Lee (1916) are the first to call it Snipe and
    Purple.
    """
fishing """
    An early and late season spider for cold days, suggesting the iron blue and other dark
    olives. Fish it just under the surface, across and down or upstream, often on a team of
    spiders.
    """
sources {
    "T. E. Pritt: Yorkshire Trout Flies (1885)" url="https://archive.org/details/yorkshiretroutfl00prit"
    "Sexyloops: North Country spiders (Ben Spinks)" url="https://www.sexyloops.com/flytying/ncspiders/ncspiders2.shtml"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://www.sexyloops.com/flytying/ncspiders/snipe%20and%20purple.jpg" page="https://www.sexyloops.com/flytying/ncspiders/ncspiders2.shtml" author="Ben Spinks" license="All rights reserved; reference only" note="Side view"
    "https://hawker-overend.com/wp-content/uploads/2020/12/Snipe-Purple-Spider-450w.jpg" page="https://hawker-overend.com/north-country-spiders/" license="All rights reserved; reference only" note="Side view"
    "https://www.fish4flies.com/img/flies/Large/1513-1513.jpg" page="https://www.fish4flies.com/Wet/Spiders/Snipe-Purple" license="All rights reserved; reference only" flip=#true note="Side view"
}

hook wet-standard size=16
thread purple size="8/0"

materials {
    hackle snipe-hackle fibre=1.8 label="Dark snipe covert (marginal covert of the wing)"
}

steps {
    attach-thread at=0.88
    wrap-thread to=0.4 note="To roughly above the hook point: spiders have short bodies."
    wrap-thread to=0.86 note="A thin, even, single layer of silk."
    tie-in hackle note="By the tip, paler side up, barbs reaching just past the bend."
    wrap-thread to=0.93
    wind hackle to=0.93 turns=2 note="The barbs should splay like the spokes of an umbrella."
    tie-off hackle
    whip-finish note="A small purple head."
}
