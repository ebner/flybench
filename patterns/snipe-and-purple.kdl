// Snipe & Purple: a North Country spider: purple silk and a dark snipe covert.

id snipe-and-purple
name "Snipe & Purple"
aliases "Dark Snipe" "Snipe and Purple"
type wet
imitates mayfly
difficulty beginner
species trout grayling
season march april may september october
origin region="North of England"
description "A short body of purple silk and one or two turns of a dark grey snipe covert feather."
history """
    A Yorkshire and Lancashire Dales spider. Pritt gave it as the "Dark Snipe" in Yorkshire
    Trout Flies (1885), a killer "on very cold days in the early part of the season, and a
    favourite on the Ribble". The earliest source found that calls it Snipe and Purple is
    Edmonds and Lee's Brook and River Trouting (1916), as "Dark Snipe or Snipe and Purple",
    hackled with a dark marginal covert from a snipe's wing.
    """
fishing """
    An early and late season spider for cold days, usually taken for the iron blue; in
    smaller sizes it also passes for midges and other small dark flies. Fish it just under
    the surface, across and down or upstream, often on a team with the Partridge & Orange
    and Waterhen Bloa.
    """
sources {
    "T. E. Pritt: Yorkshire Trout Flies (1885)" url="https://archive.org/details/yorkshiretroutfl00pritrich"
    "Edmonds & Lee, Brook and River Trouting (1916)" url="https://archive.org/details/brookrivertrouti00edmorich"
    "Sexyloops: North Country Spiders part 2 (Ben Spinks)" url="https://www.sexyloops.com/flytying/northcountrywets2.shtml"
    "Hawker-Overend: Spider flies, how to fish these old classics (Andrew Overend)" url="https://hawker-overend.com/how-to-tie-and-fish-north-country-spider-flies/"
    "Yorkshire Dales Fly Fishing: North Country Spiders" url="https://www.yorkshire-dales-flyfishing.com/north_country_spiders.htm"
}
// Photos for checking proportions while authoring (npm run refcheck); never published.
references {
    "https://www.sexyloops.com/flytying/ncspiders/snipe%20and%20purple.jpg" page="https://www.sexyloops.com/flytying/northcountrywets2.shtml" author="Ben Spinks" license="All rights reserved; reference only" note="Side view"
    "https://hawker-overend.com/wp-content/uploads/2020/12/Snipe-Purple-Spider-450w.jpg" page="https://hawker-overend.com/how-to-tie-and-fish-north-country-spider-flies/" license="All rights reserved; reference only" note="Side view"
    "https://www.fish4flies.com/img/flies/Large/1513-1513.jpg" page="https://www.fish4flies.com/Wet/Spider-and-Drowning-Daddies/Snipe-and-Purple" license="All rights reserved; reference only" flip=#true note="Side view"
}

hook wet-standard size=16
thread purple size="8/0"

materials {
    hackle snipe-hackle fibre=1.8 label="Dark snipe covert (marginal covert of the wing)"
}

steps {
    attach-thread at=0.88
    wrap-thread to=0.4 note="To roughly above the hook point: spiders have short bodies."
    wrap-thread to=0.86 note="A thin, even, single layer of silk."
    tie-in hackle note="By the tip, paler side up, barbs reaching just past the bend."
    wrap-thread to=0.93
    wind hackle to=0.93 turns=2 note="The barbs should splay like the spokes of an umbrella."
    tie-off hackle
    whip-finish note="A small purple head."
}
