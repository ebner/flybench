id mayfly-dun
status draft

// en name: Mayfly dun
name "Eintagsfliege, Subimago (Dun)"

// en description: The newly hatched mayfly: upright smoky wings, a slim curved body and two or three long tails. It drifts on the surface while its wings dry, then flies to the bank.
description "Die frisch geschlüpfte Eintagsfliege: aufrechte, rauchgraue Flügel, ein schlanker, gebogener Körper und zwei oder drei lange Schwanzfäden. Sie treibt auf der Oberfläche, während ihre Flügel trocknen, und fliegt dann ans Ufer."

// en examples: olives (Baetis), blue-winged olive (Serratella), iron blue (Alainites), mayfly (Ephemera)
examples "Olives (Baetis), Blue Winged Olive (Serratella), Iron Blue (Alainites), Maifliege (Ephemera)"

hatches {
    // en southern-sweden time: midday
    // en southern-sweden note: Baetis: two generations, spring and autumn (Dalarna 2013).
    southern-sweden time="mittags" note="Baetis: zwei Generationen, im Frühjahr und im Herbst (Dalarna 2013)."
    // en northern-scandinavia note: Estimate: one generation in the mountains.
    northern-scandinavia note="Schätzung: im Gebirge eine Generation."
    // en british-isles time: midday
    // en british-isles note: Large dark olive from February, peaks March–April and late autumn (first-nature).
    british-isles time="mittags" note="Large Dark Olive ab Februar, Höhepunkte März–April und im Spätherbst (first-nature)."
    // en central-europe note: Serratella mostly June–September; one generation July–September above 1000 m.
    central-europe note="Serratella meist Juni–September; oberhalb von 1000 m eine Generation Juli–September."
    // en northern-usa note: Blue-winged olives spring and autumn (Montana Angler).
    northern-usa note="Blue Winged Olives im Frühjahr und im Herbst (Montana Angler)."
}
