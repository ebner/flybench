id damselfly-nymph
status draft

// en name: Damselfly nymph
name "Kleinlibelle, Nymphe"

// en description: A slender nymph of weedy lakes and slow water with three leaf-like tail gills. It swims with fish-like wriggles of the body and climbs out of the water to hatch.
description "Eine schlanke Nymphe pflanzenreicher Seen und langsam fließender Gewässer mit drei blattförmigen Schwanzkiemen. Sie schwimmt mit fischartigen Schlängelbewegungen des ganzen Körpers und klettert zum Schlüpfen aus dem Wasser."

// en examples: Coenagrion, Enallagma
examples "Coenagrion, Enallagma"

hatches {
    // en southern-sweden note: Adults May–August (Wikipedia); nymphs migrate to hatch just before.
    southern-sweden note="Flugzeit Mai–August (Wikipedia); kurz vorher machen sich die Nymphen auf den Weg zum Schlüpfen."
    // en northern-scandinavia note: Estimate.
    northern-scandinavia note="Schätzung."
    // en british-isles note: Coenagrion puella late April to early September, best late May–mid August (DELTA).
    british-isles note="Coenagrion puella Ende April bis Anfang September, am besten Ende Mai bis Mitte August (DELTA)."
    // en central-europe note: Estimate.
    central-europe note="Schätzung."
    // en northern-usa note: Estimate.
    northern-usa note="Schätzung."
}
