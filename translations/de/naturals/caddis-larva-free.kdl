id caddis-larva-free
status draft

// en name: Caddis larva, free-living
name "Köcherfliege, freilebende Larve"

// en description: A larva without a case: green or olive, slightly flattened, with tufts of gills along the sides, a dark head and thorax plates, and hooks at the tail to hold on in fast water.
description "Eine Larve ohne Köcher: grün oder olivfarben, leicht abgeflacht, mit Kiemenbüscheln entlang der Seiten, dunklem Kopf, dunklen Platten auf der Brust und Haken am Hinterende, mit denen sie sich in schneller Strömung festhält."

// en examples: Rhyacophila, Hydropsyche
examples "Rhyacophila, Hydropsyche"

hatches {
    // en southern-sweden note: In the water all year; larvae drift often (Troutnut).
    southern-sweden note="Das ganze Jahr im Wasser; die Larven driften oft (Troutnut)."
    // en northern-scandinavia note: In the water all year; larvae drift often (Troutnut).
    northern-scandinavia note="Das ganze Jahr im Wasser; die Larven driften oft (Troutnut)."
    // en british-isles note: In the water all year; larvae drift often (Troutnut).
    british-isles note="Das ganze Jahr im Wasser; die Larven driften oft (Troutnut)."
    // en central-europe note: In the water all year; larvae drift often (Troutnut).
    central-europe note="Das ganze Jahr im Wasser; die Larven driften oft (Troutnut)."
    // en northern-usa note: In the water all year; larvae drift often (Troutnut).
    northern-usa note="Das ganze Jahr im Wasser; die Larven driften oft (Troutnut)."
}
