    cheeks "Syntetisk jungle cock"
}

notes {
    // en step 8 (tie-in underwing): A small bunch, combed out.
    step 8 "En liten bunt, utkammad."
    // en step 9 (tie-in wing-rear): A small bunch with the underfur combed out, spread round the sides and top.
    step 9 "En liten bunt med underullen utkammad, fördelad runt sidorna och ovansidan."
    // en step 11 (tie-in flash-rear): A few strands either side.
    step 11 "Några strån på var sida."
    // en step 14 (wind hackle-rear): Stroke the fibres back as you wind, so they lift the next section.
    step 14 "Stryk fibrerna bakåt medan du lindar, så att de lyfter nästa sektion."
    // en step 17 (tie-in wing-front): A larger bunch, the butts cut square and bound along the tube.
    step 17 "En större bunt, ändarna klippta raka och bundna längs tuben."
    // en step 22 (wind hackle-front): A long, soft collar, stroked back.
    step 22 "En lång, mjuk krage, struken bakåt."
    // en step 24 (tie-in topping): A few strands over the top of the wing.
    step 24 "Några strån över vingens ovansida."
    // en step 26 (whip-finish): Glue the head.
    step 26 "Limma huvudet."
}
