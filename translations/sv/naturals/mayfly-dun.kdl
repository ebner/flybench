id mayfly-dun
status draft

// en name: Mayfly dun
name "Dagslända, subimago"

// en description: The newly hatched mayfly: upright smoky wings, a slim curved body and two or three long tails. It drifts on the surface while its wings dry, then flies to the bank.
description "Den nykläckta dagsländan: upprättstående, rökgrå vingar, en smal, svängd kropp och två eller tre långa stjärtspröt. Den driver på ytan medan vingarna torkar och flyger sedan in till stranden."

// en examples: olives (Baetis), blue-winged olive (Serratella), iron blue (Alainites), mayfly (Ephemera)
examples "ådagsländor (Baetis), blue-winged olive (Serratella), iron blue (Alainites), sanddagsländor (Ephemera)"

hatches {
    // en southern-sweden time: midday
    // en southern-sweden note: Baetis: two generations, spring and autumn (Dalarna 2013).
    southern-sweden time="mitt på dagen" note="Baetis: två generationer, vår och höst (Dalarna 2013)."
    // en northern-scandinavia note: Estimate: one generation in the mountains.
    northern-scandinavia note="Uppskattning: en generation i fjällen."
    // en british-isles time: midday
    // en british-isles note: Large dark olive from February, peaks March–April and late autumn (first-nature).
    british-isles time="mitt på dagen" note="Large dark olive från februari, flest i mars–april och på senhösten (first-nature)."
    // en central-europe note: Serratella mostly June–September; one generation July–September above 1000 m.
    central-europe note="Serratella mest i juni–september; en generation i juli–september över 1 000 m."
    // en northern-usa note: Blue-winged olives spring and autumn (Montana Angler).
    northern-usa note="Blue-winged olive på våren och hösten (Montana Angler)."
}
