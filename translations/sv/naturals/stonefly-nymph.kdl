id stonefly-nymph
status draft

// en name: Stonefly nymph
name "Bäcksländenymf"

// en description: A flat, sturdy nymph with two tails, long antennae and sprawling legs, clinging under stones in fast water for up to three years. Dislodged nymphs drift helplessly; before hatching they crawl out onto the stones.
description "En platt, kraftig nymf med två stjärtspröt, långa antenner och utspärrade ben, som håller sig fast under stenar i strömt vatten i upp till tre år. Nymfer som slitits loss driver hjälplöst; före kläckningen kryper de upp på stenarna."

// en examples: Perla, Diura, Isoperla; salmonfly and golden stone (North America)
examples "Perla, Diura, Isoperla; salmonfly och golden stone (Nordamerika)"

hatches {
    // en southern-sweden note: In the water all year: one to two years as a nymph (Dalarna 2013), up to three in Perla marginata (Wikipedia de).
    southern-sweden note="I vattnet hela året: ett till två år som nymf (Dalarna 2013), upp till tre hos Perla marginata (tyska Wikipedia)."
    // en northern-scandinavia note: In the water all year: one to two years as a nymph (Dalarna 2013), up to three in Perla marginata (Wikipedia de).
    northern-scandinavia note="I vattnet hela året: ett till två år som nymf (Dalarna 2013), upp till tre hos Perla marginata (tyska Wikipedia)."
    // en british-isles note: In the water all year: one to two years as a nymph (Dalarna 2013), up to three in Perla marginata (Wikipedia de).
    british-isles note="I vattnet hela året: ett till två år som nymf (Dalarna 2013), upp till tre hos Perla marginata (tyska Wikipedia)."
    // en central-europe note: In the water all year: one to two years as a nymph (Dalarna 2013), up to three in Perla marginata (Wikipedia de).
    central-europe note="I vattnet hela året: ett till två år som nymf (Dalarna 2013), upp till tre hos Perla marginata (tyska Wikipedia)."
    // en northern-usa note: In the water all year: one to two years as a nymph (Dalarna 2013), up to three in Perla marginata (Wikipedia de).
    northern-usa note="I vattnet hela året: ett till två år som nymf (Dalarna 2013), upp till tre hos Perla marginata (tyska Wikipedia)."
}
