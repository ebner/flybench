id sculpin
name "Sculpin (bullhead)"
group baitfish
stage adult
examples "European bullhead (Cottus gobio), slimy sculpin"
description "A bottom fish of cold, clear streams: a big broad head with eyes on top, mottled brown, resting on the stones with its large pectoral fins spread like wings."
size min=60 max=80
rides crawling
body {
    // A large broad head and a tapering, spindle-shaped body with smooth, scaleless skin; the
    // head broader in males (Wikipedia; Wikipedia de: Groppe). Light brown mottled with darker
    // colour (Wikipedia), a pale belly (NatureSpot).
    // Assumption: from the side-view photos in the references, the head about 0.3 of the length
    // (tail fin left out) and about two thirds as wide as long; the body deepest just behind the
    // head at about 0.15 of the length, the back arched and the belly flat on the stones;
    // the narrow caudal peduncle about a third of that depth.
    tail length=0.25 radius=0.025 taper=2.4 color="#6a5a3a" belly="#c8b890" flatten=1.6 marks=mottle ink="#3a2e1c" top=0.028 bottom=0.024
    trunk length=0.45 radius=0.06 taper=1.3 color="#6a5a3a" belly="#d0c09a" flatten=1.0 marks=mottle ink="#3a2e1c" top=0.068 bottom=0.058
    head length=0.3 radius=0.078 taper=0.55 color="#5a4a30" belly="#c8b890" flatten=0.6 marks=mottle ink="#3a2e1c" top=0.085 bottom=0.065
}
parts {
    // Two dorsal fins, a short spiny first (6–8 spines) and a long soft second (15–18 rays);
    // 10–13 anal rays; a rounded tail fin of 13–14 rays (FishBase). The dorsal and anal fins end
    // close to the tail, leaving a short caudal peduncle (Wikipedia).
    // Assumption: positions and sizes read off the reference photos: the first dorsal fin low
    // and rounded just behind the head, the second from the middle nearly to the tail, the anal
    // fin under it starting a little behind it; the tail fin about a sixth of the length.
    fin kind=caudal at=0 base=0.085 height=0.17 rays=13 shape=rounded color="#7a6a48" clarity=0.3
    fin kind=dorsal at=0.69 base=0.13 height=0.065 spines=7 rays=7 shape=rounded color="#6a5a3a" clarity=0.3
    fin kind=dorsal at=0.54 base=0.42 height=0.09 rays=16 shape=truncate color="#7a6a48" clarity=0.3
    fin kind=anal at=0.46 base=0.33 height=0.07 rays=12 shape=truncate color="#8a7a58" clarity=0.35
    // Large pectoral fins, flared like wings (Wikipedia; NatureSpot); the pelvic fins under
    // them, colourless, their rays of similar length (Wikipedia; Wikipedia de: Groppe).
    // Assumption: the pectoral fins about a fifth of the length, fan-shaped and barred; the
    // pelvic fins narrow, about 0.11 long.
    // Assumption: spread about 70° out from the body, as it rests on the stones.
    fin kind=pectoral at=0.69 base=0.13 height=0.2 rays=14 shape=rounded color="#7a6a48" clarity=0.3 spread=70
    fin kind=pelvic at=0.7 base=0.04 height=0.11 rays=4 spines=1 shape=rounded color="#d8ccb0" clarity=0.6
    // Eyes near the top of the head (Wikipedia).
    // Assumption: from the photos, about a sixth of the head long, a golden-brown iris.
    eyes size=0.026 color="#1a140c" iris="#a08040" pupil="#0a0806"
    // Assumption: a wide terminal mouth reaching back about a third of the head; the gill
    // cover's rear edge just ahead of the pectoral fin.
    mouth position=terminal size=0.09
    gill-cover at=0.71
    // Scaleless skin (Wikipedia de: Groppe): the schema has no "no scales", so the finest
    // grain with no shine stands for smooth skin.
    scales size=0.003 shine=0
    // Assumption: a complete lateral line along the middle of the flank, pale against the mottle.
    lateral-line height=0.15 color="#9a8a62"
    // Assumption: from the photos, three or four dark saddles across the back, the last at the
    // tail's root.
    mark section=tail kind=patch side=top color="#2e2416"
}
hatches {
    southern-sweden from=january to=december note="Estimate."
    northern-scandinavia from=january to=december note="Estimate."
    british-isles from=january to=december note="Estimate."
    central-europe from=january to=december note="Estimate."
    northern-usa from=january to=december note="Estimate."
}
sources {
    "Wikipedia: European bullhead" url="https://en.wikipedia.org/wiki/European_bullhead"
    "Wikipedia (de): Groppe" url="https://de.wikipedia.org/wiki/Groppe"
    "NatureSpot: Bullhead (Cottus gobio)" url="https://www.naturespot.org/node/17695"
    "FishBase: Cottus gobio" url="https://www.fishbase.se/summary/Cottus-gobio.html"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://upload.wikimedia.org/wikipedia/commons/f/fe/2008-11-08_Germany_Lohr_Main-Cottus_gobio.JPG" page="https://commons.wikimedia.org/wiki/File:2008-11-08_Germany_Lohr_Main-Cottus_gobio.JPG" author="Ullswater" license="CC BY-SA 3.0" note="Side view, fins spread"
    "https://upload.wikimedia.org/wikipedia/commons/9/96/Hal_-_Cottus_gobio_-_2.jpg" page="https://commons.wikimedia.org/wiki/File:Hal_-_Cottus_gobio_-_2.jpg" author="Emőke Dénes" license="CC BY-SA 4.0" flip=#true note="Side view in an aquarium"
    "https://upload.wikimedia.org/wikipedia/commons/2/26/Bullhead1.jpg" page="https://commons.wikimedia.org/wiki/File:Bullhead1.jpg" author="Julien Renoult" license="CC BY 4.0" flip=#true note="On the stream bed"
}
