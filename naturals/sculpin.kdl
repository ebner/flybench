id sculpin
name "Sculpin (bullhead)"
group baitfish
stage adult
examples "European bullhead (Cottus gobio), slimy sculpin"
description "A bottom fish of cold, clear streams: a big broad head with eyes on top, mottled brown, resting on the stones with its large pectoral fins spread like wings."
size min=60 max=80
rides crawling
body {
    // A large broad, flattened head with prominent eyes near the top, a tapering body; light
    // brown mottled darker, sometimes barred, with a pale belly (Wikipedia; NatureSpot).
    // Assumption: from the photo on Wikipedia's page, the head about 0.3 of the length (tail fin
    // left out) and about two thirds as wide as long; the body deepest behind the head.
    tail length=0.25 radius=0.057 taper=0.5 color="#6a5a3a" belly="#c8b890" flatten=1.5 marks=mottle ink="#3a2e1c"
    trunk length=0.45 radius=0.07 taper=1.15 color="#6a5a3a" belly="#c8b890" flatten=1.0 marks=mottle ink="#3a2e1c"
    head length=0.3 radius=0.085 taper=0.6 color="#5a4a30" belly="#c0b088" flatten=0.65 round=0.6 marks=mottle ink="#3a2e1c"
}
parts {
    // A rounded tail fin; dorsal and anal fins ending close to it (Wikipedia). Two dorsal fins,
    // a short spiny first (6–8 spines) and a long soft second (15–18 rays); 10–13 anal rays
    // (FishBase).
    // Assumption: positions and sizes read off photos: the first dorsal fin just behind the
    // head, the second from the middle nearly to the tail, the anal fin under it.
    fin kind=caudal at=0 size=0.16 color="#7a6a48"
    fin kind=dorsal at=0.68 size=0.1 color="#7a6a48"
    fin kind=dorsal at=0.5 size=0.22 color="#7a6a48"
    fin kind=anal at=0.47 size=0.16 color="#7a6a48"
    // Large pectoral fins, flared on the bottom (Wikipedia; NatureSpot). Colourless pelvic fins
    // (Wikipedia). Assumption: the pelvic fins under the chest, narrow, about 0.12 long.
    fin kind=pectoral at=0.7 size=0.25 color="#7a6a48"
    fin kind=pelvic at=0.72 size=0.12 color="#c8bca0"
    eyes size=0.028 color="#2a2014"
}
hatches {
    southern-sweden from=january to=december note="Estimate."
    northern-scandinavia from=january to=december note="Estimate."
    british-isles from=january to=december note="Estimate."
    central-europe from=january to=december note="Estimate."
    northern-usa from=january to=december note="Estimate."
}
sources {
    "Wikipedia: European bullhead" url="https://en.wikipedia.org/wiki/European_bullhead"
    "NatureSpot: Bullhead (Cottus gobio)" url="https://www.naturespot.org/node/17695"
    "FishBase: Cottus gobio" url="https://www.fishbase.se/summary/Cottus-gobio.html"
}
