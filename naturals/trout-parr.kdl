// Brown trout fry and parr: the young of resident brown trout and sea trout in their stream.

id trout-parr
name "Trout fry and parr"
group baitfish
stage juvenile
examples "brown trout and sea trout (Salmo trutta) fry and parr"
description "Young brown trout and sea trout in their first years in the stream, before the sea trout go to sea as silvery smolts: an olive-brown back, a row of dark oval parr marks along the sides that fades with age, black and red spots, and often a red edge to the small adipose fin."
// Assumption: from fry newly up from the gravel to parr of a couple of years; a 0+ trout after
// its first summer is about 6 cm long (the Värmland photo on Wikipedia's Brown trout page).
size min=25 max=120
rides swimming
body {
    // A fusiform body, oval in section (FishBase). Parr: dark blotches along the sides that fade
    // with age, often a red-edged adipose fin (Wikipedia); dark and red spots on the sides
    // (Wikipedia, of the brown trout). Lengths leave out the tail fin.
    // Assumption: from the USFWS fingerling photo (flipped), in body lengths: the head 0.25, the
    // body 0.24 deep at the dorsal fin, the tail stalk 0.09 deep at the tail fin, back and belly
    // about equally curved; about nine parr marks, from behind the head to the tail stalk.
    tail length=0.3 radius=0.035 taper=2.1 color="#5a5430" belly="#e6e0c4" flatten=2.4 marks=spots ink="#2a2418" top=0.045 bottom=0.043
    trunk length=0.45 radius=0.075 taper=1.08 color="#5a5430" belly="#ebe6cc" flatten=1.8 round=0.4 marks=spots ink="#2a2418" top=0.112 bottom=0.108
    head length=0.25 radius=0.075 taper=0.22 color="#55502e" belly="#e6e0c8" flatten=1.6 marks=spots ink="#2a2418" top=0.11 bottom=0.105
}
parts {
    // The parr marks, and red spots between them (half a mark along):
    mark section=tail kind=bars side=sides count=3 color="#4a4a3c"
    mark section=trunk kind=bars side=sides count=6 color="#4a4a3c"
    mark section=trunk kind=spots side=sides count=6 offset=0.5 color="#c8502c"
    // FishBase counts 3–4 unbranched and 10–15 branched dorsal rays, 3–4 and 9–14 in the anal fin;
    // the unbranched ones are soft in a trout, so they are counted here as rays, not spines. 18–19
    // caudal rays (FishBase). A red margin on the adipose fin (FishBase; Wikipedia: often in parr).
    // Assumption: positions and sizes from the USFWS photos: the dorsal fin starting just in front
    // of the middle, the pelvic fins under its middle, the anal fin and the adipose fin over it
    // near the tail; a slightly notched tail fin, less forked than a salmon parr's (Norske
    // Lakseelver).
    fin kind=caudal at=0 base=0.09 height=0.15 rays=19 shape=emarginate clarity=0.3 color="#6a6848"
    fin kind=dorsal at=0.51 base=0.19 height=0.12 rays=14 shape=truncate clarity=0.3 color="#5e5a40"
    fin kind=adipose at=0.16 base=0.055 height=0.04 rays=0 clarity=0 color="#b0603a"
    fin kind=anal at=0.21 base=0.11 height=0.09 rays=12 shape=truncate clarity=0.3 color="#9a9468"
    fin kind=pelvic at=0.45 base=0.05 height=0.11 clarity=0.3 color="#a09a68"
    fin kind=pectoral at=0.76 base=0.05 height=0.13 clarity=0.3 color="#a09a68"
    // A longer jaw than a salmon parr's (Norske Lakseelver). Assumption: from the photos, the mouth
    // reaching under the eye's middle or rear, 0.12 of the length; a large eye, 0.065 across;
    // scales about 0.009 of the length (some 115 along the side).
    mouth position=terminal size=0.12
    gill-cover at=0.75
    eyes size=0.033 color="#1a1a14" iris="#c8b070" pupil="#0a0a08"
    scales size=0.009 shine=0.1
    // Assumption: the lateral line a little above the middle of the flank, faintly darker.
    lateral-line height=0.05 color="#3a3826"
}
hatches {
    southern-sweden from=january to=december note="Estimate: in the stream all year; the new fry come up from the gravel in spring."
    northern-scandinavia from=january to=december note="Estimate: in the stream all year; the new fry come up from the gravel in spring."
    british-isles from=january to=december note="Estimate: in the stream all year; the new fry come up from the gravel in spring."
    central-europe from=january to=december note="Estimate: in the stream all year; the new fry come up from the gravel in spring."
    northern-usa from=january to=december note="Estimate: where brown trout were introduced (Wikipedia); in the stream all year, the new fry up from the gravel in spring."
}
sources {
    "Wikipedia: Brown trout" url="https://en.wikipedia.org/wiki/Brown_trout"
    "FishBase: Salmo trutta" url="https://www.fishbase.se/summary/Salmo-trutta.html"
    "Norske Lakseelver: Salmon recognition (leaflet, 2019)" url="https://lakseelver.no/sites/default/files/Gjenkjenningsfolder%2C%20engelsk%2C%202019.pdf"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://upload.wikimedia.org/wikipedia/commons/4/45/Brown_Trout_Fingerling_%2852979322720%29.jpg" page="https://commons.wikimedia.org/wiki/File:Brown_Trout_Fingerling_(52979322720).jpg" author="Sam Stukel, USFWS Mountain-Prairie" license="Public domain" flip=#true note="Hatchery fingerling, side view, faint parr marks, red spots"
    "https://upload.wikimedia.org/wikipedia/commons/e/e9/Brown_trout_fry_Pudisoo_river.jpg" page="https://commons.wikimedia.org/wiki/File:Brown_trout_fry_Pudisoo_river.jpg" author="Jürgen Karvak" license="CC BY-SA 4.0" flip=#true note="Wild fry in its first summer, under water, parr marks"
    "https://upload.wikimedia.org/wikipedia/commons/9/98/Salmo_trutta_01_by-dpc.jpg" page="https://commons.wikimedia.org/wiki/File:Salmo_trutta_01_by-dpc.jpg" author="David Perez" license="CC BY 3.0" flip=#true note="Older parr, about 18 cm, on a ruler, red-edged adipose fin"
}
