id beetle
name "Beetle"
group terrestrial
stage adult
examples "garden chafer (Phyllopertha horticola)"
description "A stout, round beetle with hard wing cases. The garden chafer has chestnut-brown cases and a shiny dark green head and thorax; it lands on the water with a plop and floats low."
size min=8.5 max=11
rides in-film
body {
    // The chestnut-brown wing cases, covered with long upright hairs, cover the back; head,
    // thorax and legs shiny dark green or bluish, the underside green too (Wikipedia).
    // Assumption: from the photo on Wikipedia's page, the wing cases about 0.58 of the length,
    // the thorax 0.27 and the head 0.15; long pale hairs at the sides and under the thorax.
    abdomen length=0.58 radius=0.21 taper=0.8 color="#7a4a22" belly="#1e2a1e" flatten=0.75 round=1 hairs=0.35
    thorax length=0.27 radius=0.19 taper=0.8 color="#1e3024" belly="#1e2a1e" flatten=0.75 round=0.7 hairs=0.5
    head length=0.15 radius=0.12 taper=0.8 color="#1a2a20" flatten=0.75 round=1 hairs=0.15
}
parts {
    // Assumption: from the photo, the legs reach a little under half the body length out, with
    // long jointed feet ending in claws.
    legs count=6 length=0.45 color="#1e3024" femur=0.34 tibia=0.32 hairs=0.15
    // Short antennae ending in a club of three leaves (Wikipedia); about 0.15 in the photo.
    antennae length=0.15 color="#2a2a1e"
    eyes size=0.03 color=black
}
hatches {
    southern-sweden from=june to=june note="Estimate."
    british-isles from=april to=july note="Many in June (Wikipedia); the Coch-y-Bonddu is best in June."
    central-europe from=may to=july note="Estimate."
    northern-usa from=july to=september note="Beetles from mid-July on the Madison (Montana Angler); the end is an estimate."
}
sources {
    "Wikipedia: Phyllopertha horticola" url="https://en.wikipedia.org/wiki/Phyllopertha_horticola"
    "Montana Angler: Madison River hatch chart" url="https://www.montanaangler.com/montana-fly-fishing-rivers/madison-river-hatch-chart-fishing"
}
