id freshwater-shrimp
name "Freshwater shrimp (Gammarus)"
group crustacean
stage adult
examples "Gammarus pulex; coastal gammarids"
description "A small crustacean flattened from side to side, curled into a C at rest and straighter when it swims on its side. Translucent grey, brown or olive; abundant all year in streams and along coasts."
size min=6 max=21
rides swimming
curve 110
body {
    abdomen length=0.34 radius=0.07 taper=0.6 segments=6 color="#8a8a68" belly="#a8a888" flatten=2 translucency=0.4
    thorax length=0.54 radius=0.085 taper=1.0 segments=7 color="#7e7e5c" belly="#a0a080" flatten=2 translucency=0.4
    head length=0.12 radius=0.07 taper=0.7 color="#7a7a58" flatten=1.8 translucency=0.4
}
parts {
    // Seven pairs of thoracic legs, two pairs of antennae (Wikipedia: Gammarus pulex).
    legs count=14 length=0.22 color="#9a9a78"
    // Assumption: the first antennae about half the body length.
    antennae length=0.5 color="#8a8a68"
    eyes size=0.02 color="#2a1a10"
}
hatches {
    southern-sweden from=january to=december note="All year, several broods a year (Wikipedia); coastal fishing in southern Scandinavia all year (Ahrex)."
    northern-scandinavia from=january to=december note="All year, several broods a year (Wikipedia); coastal fishing in southern Scandinavia all year (Ahrex)."
    british-isles from=january to=december note="All year, several broods a year (Wikipedia); coastal fishing in southern Scandinavia all year (Ahrex)."
    central-europe from=january to=december note="All year, several broods a year (Wikipedia); coastal fishing in southern Scandinavia all year (Ahrex)."
    northern-usa from=january to=december note="All year, several broods a year (Wikipedia); coastal fishing in southern Scandinavia all year (Ahrex)."
}
sources {
    "Wikipedia: Gammarus pulex" url="https://en.wikipedia.org/wiki/Gammarus_pulex"
    "Wikipedia: Amphipoda" url="https://en.wikipedia.org/wiki/Amphipoda"
    "Wikipedia (de): Bachflohkrebs" url="https://de.wikipedia.org/wiki/Bachflohkrebs"
    "Ahrex (Michael Jensen) 2017: Gammarus, small but important" url="https://ahrexhooks.com/2017/11/23/gammarus-small-but-important/"
}
