id midge-adult
name "Midge adult"
group chironomid
stage adult
examples "non-biting midges (Chironomidae)"
description "A small, slender fly with one pair of wings held back over its body, long legs and, in the males, feathery antennae. Mating clusters drift on the surface on calm evenings."
size min=2 max=10
rides on-surface
body {
    // Lighter bands between the abdominal segments (Wikipedia de: Chironomus plumosus).
    abdomen length=0.62 radius=0.05 taper=0.65 segments=8 color="#2a2a26" marks=bands ink="#5e5c4a"
    // A high-arched thorax (Wikipedia de).
    thorax length=0.26 radius=0.075 taper=0.85 color="#24221e" round=0.6
    head length=0.12 radius=0.05 taper=0.7 color="#24221e"
}
parts {
    // One pair of long, narrow wings (MDC), roof-like at rest (Wikipedia de); 6–8 mm on a 9–13 mm Chironomus plumosus
    // (Wikipedia de: Chironomus plumosus). Assumption: a wing about a quarter as wide as it is long.
    wings count=2 shape=back length=0.65 width=0.17 color="#d0d4d4" clarity=0.75 veins=#true
    // Antennae with whorls of hairs (Wikipedia de), feathery in the males (MDC).
    antennae length=0.4 color="#3a3a30"
    // Long, skinny legs, the front pair held forward and up, their feet very long in many midges (MDC); in C. plumosus
    // the fore thigh and shin about equal and the first foot joint longer than the shin (chironomidae.net).
    // Assumption: over all three pairs, the foot a little under half the leg.
    legs count=6 length=0.8 femur=0.28 tibia=0.28 color="#3a3a30"
    eyes size=0.028 color=black
}
hatches {
    southern-sweden from=april to=october note="Estimate: peak May–June."
    northern-scandinavia from=june to=september note="Dark midges swarm on warm June days (Visit Dalarna); otherwise an estimate."
    british-isles from=january to=december time="morning, evening" note="On stillwaters all year, sparse in November–December; big buzzers March–April, peak May–June, again September–October (The Essential Fly)."
    central-europe from=april to=october note="Estimate, as in Britain."
    northern-usa from=january to=december note="Whenever the water is ice-free; lake peak late May to mid-June (BC Adventure)."
}
sources {
    "Missouri Department of Conservation: Midges" url="https://mdc.mo.gov/discover-nature/field-guide/midges"
    "Wikipedia (de): Zuckmücken" url="https://de.wikipedia.org/wiki/Zuckmücken"
    "Wikipedia: Chironomidae" url="https://en.wikipedia.org/wiki/Chironomidae"
    "Wikipedia (de): Chironomus plumosus" url="https://de.wikipedia.org/wiki/Chironomus_plumosus"
    "Martin, chironomidae.net: Chironomus species in the Nearctic (C. plumosus)" url="https://chironomidae.net/Martin/NACytfiles/Spp.html"
    "First Nature: Chironomids, buzzer midges" url="https://mail.first-nature.com/insects/d-chironomus-plumosus.php"
}
