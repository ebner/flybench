// Up to about 30 mm (Wikipedia; First Nature).

id mayfly-nymph-burrowing
name "Mayfly nymph, burrowing"
group mayfly
stage nymph
examples "the mayfly (Ephemera danica, E. vulgata)"
description "The big nymph of the mayfly, living for one to three years in burrows in sand and silt, waving its feathery gills over its back. It rises to the surface to hatch."
size min=18 max=30
rides crawling
body {
    // Narrow, cylindrical, yellowish light brown (Wikipedia de: Ephemera danica). The nymph already carries dark
    // markings on the abdomen like the adult's (Naturschutzbund); E. danica's are elongated and solid on segments
    // 7 to 9 (First Nature). Assumption: drawn as a dark stripe along the back.
    abdomen length=0.62 radius=0.06 taper=0.5 segments=10 color="#cdbb86" belly="#e0d4aa" marks=stripe ink="#6a5230"
    thorax length=0.25 radius=0.07 taper=0.95 color="#b8a470"
    head length=0.13 radius=0.055 taper=0.7 color="#a8925e"
}
parts {
    // Three tails about 10 mm on a 30 mm nymph (Wikipedia de: Ephemera danica). Assumption: fringed with fine
    // hairs, as photos show.
    tails count=3 length=0.35 spread=40 color="#b8a470" hairs=0.5
    // Seven pairs of deeply split gills with fringed edges (Naturschutzbund), each two-branched with fine
    // filaments, held over the back over the first half of the abdomen (DCRT); forked, lanceolate and fringed
    // on segments 2–7, giving a fluffy look from above (macroinvertebrates.org).
    gills count=7 length=0.12 color="#d8c898" shape=feather
    // Slender, slightly curved, tusk-like mandibles for digging (Naturschutzbund), projecting forward, visible
    // from above and curving upward seen from the side (macroinvertebrates.org). Assumption: about as long as
    // the head.
    tusks length=0.09 color="#c8b07a"
    wingpads length=0.2 color="#6a5530"
    // Short, sturdy legs (Wikipedia de: Ephemera danica) used as digging shovels (Naturschutzbund); fore tibiae
    // widened for burrowing (macroinvertebrates.org); mayfly nymphs' legs are often clad in bristles and hairs
    // (Wikipedia: Mayfly). Assumption: femur and tibia about equal, a short foot, well haired.
    legs count=6 length=0.4 color="#b8a470" femur=0.4 tibia=0.36 hairs=0.5
    antennae length=0.2 color="#a8925e"
    eyes size=0.022 color=black
}
hatches {
    southern-sweden from=may to=june note="E. vulgata in May; Scandinavian peak usually the first week of June (Ahrex)."
    northern-scandinavia from=june to=july note="Estimate."
    british-isles from=may to=june time="afternoon" note="Main hatch from mid-May to the first week of June (First Nature)."
    central-europe from=may to=june note="Main hatch; egg-laying females May–September (Naturschutzbund)."
    northern-usa from=may to=june time="afternoon" note="Brown and green drakes (Troutnut; Beaverkill)."
}
sources {
    "Wikipedia: Ephemera danica" url="https://en.wikipedia.org/wiki/Ephemera_danica"
    "Wikipedia (de): Ephemera danica" url="https://de.wikipedia.org/wiki/Ephemera_danica"
    "Macroinvertebrates.org: Ephemeridae (larva)" url="https://www.macroinvertebrates.org/taxa-info/ephemeroptera-larva/ephemeridae"
    "Wikipedia: Mayfly" url="https://en.wikipedia.org/wiki/Mayfly"
    "Naturschutzbund Österreich: Insekt des Jahres 2021, Dänische Eintagsfliege" url="https://naturschutzbund.at/insekt-leser/items/id-2021-daenische-eintagsfliege.html?pdf=645"
    "First Nature: Mayfly (Ephemera danica)" url="https://www.first-nature.com/insects/e-ephemera-danica.php"
    "Hancock / Don Catchment Rivers Trust: Mayfly Identification (after FBA 66)" url="https://dcrt.org.uk/wp-content/uploads/2026/01/Mayfly-Identification-DCRT-Paul-Hancock-pdf.pdf"
    "Ahrex (Lars Chr. Bentsen) 2024: It's that time of year again" url="https://ahrexhooks.com/2024/05/17/its-that-time-of-year-again/"
    "Troutnut: Genus Ephemera" url="https://www.troutnut.com/hatch/52/Mayfly-Ephemera-Brown-Drakes"
    "Dick Talleur, Fly Fisherman: Meeting the Beaverkill Hatches" url="https://www.flyfisherman.com/editorial/meeting-beaverkill-hatches/461963"
}
