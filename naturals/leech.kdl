// Assumption: the leeches trout eat are 2–6 cm.

id leech
name "Leech"
group crustacean
stage adult
examples "freshwater leeches (Erpobdellidae)"
description "A soft, flattened, segmented worm with a sucker at each end, swimming with slow undulations of the whole body. Black, brown or olive."
size min=20 max=60
rides swimming
body {
    body length=1.0 radius=0.07 taper=0.6 segments=20 color="#1e1e1a" belly="#3a3a30" flatten=0.5
}
parts {
}
hatches {
