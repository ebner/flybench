id mayfly-spinner
name "Mayfly spinner"
group mayfly
stage spinner
examples "sherry spinner (Serratella), red spinner (Baetis), the mayfly"
description "The mature mayfly: clear glassy wings, long tails and a shiny body. After mating the females lay their eggs and fall spent on the water, wings flat out."
size min=6 max=11
rides on-surface
// Assumption: spent, body and wings lie flat in the film (photos).
sits spent
curve -8
body {
    // A male Baetis rhodani spinner's front abdomen is glass-clear (Dalarna 2013). Assumption: the female drawn
    // here a little translucent too.
    // Assumption: the abdomen widest at the front, tapering to the tip (photos); radius at the rear, taper forward.
    abdomen length=0.62 radius=0.03 taper=1.7 segments=10 color="#7a3a22" belly="#9a5a3a" translucency=0.2
    // The second thoracic segment is enlarged for the flight muscles (Wikipedia: Mayfly). Assumption: the thorax
    // about a sixth of the body deep, humped (photos).
    thorax length=0.27 radius=0.085 taper=0.85 color="#5a2c18" round=0.5
    head length=0.11 radius=0.05 taper=0.7 color="#4a2414"
}
parts {
    // Tails longer than the dun's, 1.5–3 × the body (Dalarna 2013). Assumption: 1.8 × in the female drawn here.
    tails count=2 length=1.8 spread=30 color="#5a3a2a"
    // Clear, glassy wings with dark veins (Dalarna 2013; First Nature), spent on the water; unhaired except in
    // Caenis (Wikipedia de: Eintagsfliegen). Two tails and a tiny hind wing as in the red spinner (Baetis: Dalarna
    // 2013; Hackston 2021); Serratella's sherry spinner has three tails and a "large oval hindwing" (Wikipedia de:
    // Serratella ignita; First Nature), Ephemera a hind wing a third to a half of the forewing (Troutnut key).
    // Assumption: hind wing an eighth of the forewing.
    wings count=2 shape=spent length=0.95 width=0.45 color="#b8bec4" clarity=0.7 veins=#true hind=0.12
    // Drawn as a female: the spent spinners on the water are the egg-layers (see the description). The males'
    // front legs are the unusually long ones (Wikipedia: Mayfly; a male Baetis's foreleg is femur 1.2, tibia 1.7,
    // foot 0.7, 0.7, 0.4, 0.2 mm on a 5.2 mm body: Tiunova 2024). Assumption: the female's foreleg about 0.55 of
    // the body, held forward, its foot in four joints like the male's.
    legs pair=fore count=2 length=0.55 color="#5a3a2a" femur=0.3 tibia=0.34 tarsi=4 pose=forward
    // Baetidae: the hind foot in three separate joints (Hackston 2021); adults' feet (3–)5-jointed (DELTA).
    // Assumption: the middle legs as the hind, a little over half the body long (photos).
    legs count=6 length=0.55 color="#5a3a2a" femur=0.4 tibia=0.34 tarsi=3
    // "Short, flexible antennae" (Wikipedia: Mayfly). Assumption: under a tenth of the body.
    antennae length=0.08 color="#4a2414"
    // Three ocelli (Wikipedia: Mayfly; DELTA); the female has no turbinate eyes, those are the male Baetis's
    // (Tiunova 2024).
    eyes size=0.035 color="#3a1a10" ocelli=#true
}
hatches {
    southern-sweden from=april to=october time="evening" note="Baetis: two generations, spring and autumn (Dalarna 2013)."
    northern-scandinavia from=june to=august note="Estimate: one generation in the mountains."
    british-isles from=february to=october time="evening" note="Large dark olive peaks March–April and late autumn (First Nature)."
    central-europe from=april to=september note="Serratella mostly June–September; above 1000 m July–September (Wikipedia de)."
    northern-usa from=march to=october note="Blue-winged olives in spring and autumn (Montana Angler)."
}
sources {
    "Lingdell & Engblom 2013: Fakta om småkryp i Dalarnas vattendrag (Länsstyrelsen Dalarna, rapport 2013:06)" url="https://catalog.lansstyrelsen.se/store/26/resource/2013_06"
    "First Nature: Blue-winged Olive" url="https://www.first-nature.com/insects/e-serratella-ignita.php"
    "First Nature: Large Dark Olive" url="https://first-nature.com/insects/e-baetis-rhodani.php"
    "First Nature: Mayfly (Ephemera danica)" url="https://www.first-nature.com/insects/e-ephemera-danica.php"
    "Wikipedia: Mayfly" url="https://en.wikipedia.org/wiki/Mayfly"
    "Wikipedia (de): Eintagsfliegen" url="https://de.wikipedia.org/wiki/Eintagsfliegen"
    "Wikipedia (de): Serratella ignita" url="https://de.wikipedia.org/wiki/Serratella_ignita"
    "Hackston 2021: Key to UK families and genera of adult Ephemeroptera (after Elliott & Humpesch 1983, Kimmins 1950)" url="https://quelestcetanimal-lagalerie.com/wp-content/uploads/2022/02/Order-Ephemeroptera-key-to-British-families-adults.pdf"
    "Troutnut: Easy Angler's Key to Identify Common Adult Mayflies, couplet 6" url="https://www.troutnut.com/taxonomic-key/110/Easy-Anglers-Key-to-Identify-Common-Adult-Mayflies/couplet-6"
    "Tiunova 2024: A description of the adult male Baetis pentaphyllus (Euroasian Entomological Journal 23(1))" url="https://kmkjournals.com/upload/PDF/EEJ/23/23_1_018_021_Tiunova.pdf"
    "DELTA, British Insects: the orders, Ephemeroptera" url="https://www.delta-intkey.com/britin/ord/www/ephemero.htm"
}
references {
    "https://upload.wikimedia.org/wikipedia/commons/f/f0/Cloeon_dipterum_agg._female_imago_Bytom.jpg" page="https://commons.wikimedia.org/wiki/File:Cloeon_dipterum_agg._female_imago_Bytom.jpg" author="Adrian Tync" license="CC BY-SA 4.0" note="Female Cloeon spinner (Baetidae), side view, wings raised"
    "https://upload.wikimedia.org/wikipedia/commons/4/4a/Cloeon_dipterum_%28Baetidae%29_-_%28female_imago%29%2C_Elst_%28Gld%29%2C_the_Netherlands.jpg" page="https://commons.wikimedia.org/wiki/File:Cloeon_dipterum_(Baetidae)_-_(female_imago),_Elst_(Gld),_the_Netherlands.jpg" author="B. Schoenmakers (waarneming.nl)" license="CC BY 3.0" flip=#true note="Female Cloeon spinner, side view"
    "https://upload.wikimedia.org/wikipedia/commons/6/69/Mayfly_%28Baetis_sp.%29_%2814328729732%29.jpg" page="https://commons.wikimedia.org/wiki/File:Mayfly_(Baetis_sp.)_(14328729732).jpg" author="Bernard Dupont" license="CC BY-SA 2.0" flip=#true note="Baetis spinner, small eyes (a female), side view"
}
