id midge-larva
name "Midge larva"
group chironomid
stage larva
examples "bloodworms (Chironomus)"
description "A slender, segmented worm living in tubes in the mud of lakes and slow rivers; bloodworms are bright red with haemoglobin. It swims, when it must, by lashing from side to side."
// Assumption: 8–15 mm; about 1 cm (Wikipedia), 10–15 mm when they pupate (First Nature).
size min=8 max=15
rides swimming
curve 70
body {
    // Slender and worm-like: a head capsule, three thoracic and nine abdominal segments (Wikipedia de).
    // Assumption: the head capsule narrower than the body and brown, about a twentieth of its length; the body
    // about a sixteenth of its length thick (photos).
    abdomen length=0.75 radius=0.032 taper=1.05 segments=9 color="#a02424" belly="#c04040" translucency=0.25
    thorax length=0.19 radius=0.034 taper=0.95 segments=3 color="#a02424" belly="#c04040" translucency=0.25
    head length=0.06 radius=0.026 taper=0.8 color="#6a3418" round=0.6
}
parts {
    eyes size=0.012 color="#2a0a0a"
    // A pair of stumpy legs on the first thoracic segment and a pair of rear prolegs (Nachschieber) on the last
    // segment (Wikipedia de: Zuckmücken), both crowned with small claws. Assumption: each about a twenty-fifth of
    // the body long (photos).
    prolegs count=1 at=thorax where=front length=0.04 hooks=#true color="#b03030"
    prolegs count=1 at=abdomen where=rear length=0.045 hooks=#true color="#b03030"
}
hatches {
    southern-sweden from=april to=october note="Estimate: peak May–June."
    northern-scandinavia from=june to=september note="Dark midges swarm on warm June days (Visit Dalarna); otherwise an estimate."
    british-isles from=january to=december time="morning, evening" note="On stillwaters all year, sparse in November–December; big buzzers March–April, peak May–June, again September–October (The Essential Fly)."
    central-europe from=april to=october note="Estimate, as in Britain."
    northern-usa from=january to=december note="Whenever the water is ice-free; lake peak late May to mid-June (BC Adventure)."
}
sources {
    "Missouri Department of Conservation: Midges" url="https://mdc.mo.gov/discover-nature/field-guide/midges"
    "Wikipedia: Chironomidae" url="https://en.wikipedia.org/wiki/Chironomidae"
    "Wikipedia (de): Zuckmücken" url="https://de.wikipedia.org/wiki/Zuckmücken"
    "First Nature: Chironomids, buzzer midges" url="https://mail.first-nature.com/insects/d-chironomus-plumosus.php"
}
references {
    "https://upload.wikimedia.org/wikipedia/commons/f/fe/Chironomus_spec._%28Chironomidae%29_-_%28larva%29%2C_Elst_%28Gld%29%2C_the_Netherlands.jpg" page="https://commons.wikimedia.org/wiki/File:Chironomus_spec._(Chironomidae)_-_(larva),_Elst_(Gld),_the_Netherlands.jpg" author="B. Schoenmakers (waarneming.nl)" license="CC BY 3.0" note="Chironomus bloodworm, curled, head top right"
    "https://upload.wikimedia.org/wikipedia/commons/e/ed/Single_Bloodworm.jpg" page="https://commons.wikimedia.org/wiki/File:Single_Bloodworm.jpg" author="Bill Kasman" license="CC0" note="Bloodworm, head right"
    "https://upload.wikimedia.org/wikipedia/commons/d/d7/Mikrofoto.de-Zuckmueckenlarve3.jpg" page="https://commons.wikimedia.org/wiki/File:Mikrofoto.de-Zuckmueckenlarve3.jpg" author="Frank Fox" license="CC BY-SA 3.0 de" note="Chironomid larva under the microscope: head capsule, front and rear prolegs"
}
