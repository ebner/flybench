id caddis-pupa
name "Caddis pupa"
group caddis
stage pupa
examples "sedges of all kinds"
description "The pupa cuts out of its case and rises or swims to hatch, rowing with its oar-like legs, the wing sheaths dark along its sides and the antennae swept back."
// Assumption: 8–18 mm; pupae are one to three hook sizes smaller than the larvae (Troutnut).
size min=8 max=18
rides swimming
curve 20
body {
    // Broad fringes of hairs or bristles along the abdomen, to help it out (Wikipedia de).
    // Assumption, from the photos and the drawing: stout, about a fifth of its length deep, the abdomen thick to its
    // last two segments; green under brown hairs (Cheumatopsyche, Hydropsyche).
    abdomen length=0.62 radius=0.06 taper=1.6 segments=9 color="#8aa05a" belly="#b8c888" translucency=0.2 hairs=0.25 round=0.4
    thorax length=0.26 radius=0.095 taper=0.8 color="#8a6a3a" belly="#b89a5a"
    head length=0.12 radius=0.065 taper=0.75 color="#7a5a32" round=0.6
}
parts {
    // Wing sheaths along the sides, darkening before hatching (Troutnut). Assumption: from the thorax to about the
    // middle of the abdomen (photos; Kluge's drawing).
    wingpads length=0.42 color="#2e2a1c"
    // Antennae swept back along the body, at least as long as it in the photos (Cheumatopsyche's reach past the tip).
    // Assumption: 1.1 body lengths.
    antennae length=1.1 color="#7a5a32" swept=#true
    // Swimming legs (Wikipedia: Caddisfly): it rows with the middle pair (UC Riverside), their feet fringed with long
    // hairs (Müller 1879). Five-jointed feet as in the adult (Wikipedia: Caddisfly).
    // Assumption: the other legs folded along the underside, their feet reaching back past the wing sheaths, the
    // middle pair the longest (photos; Kluge's drawing).
    legs pair=fore count=2 length=0.5 femur=0.3 tibia=0.34 tarsi=5 pose=folded color="#9a7a42"
    legs pair=mid count=2 length=0.7 femur=0.28 tibia=0.34 tarsi=5 hairs=0.8 pose=rowing color="#9a7a42"
    legs pair=hind count=2 length=0.6 femur=0.28 tibia=0.34 tarsi=5 pose=folded color="#9a7a42"
    // Large compound eyes (photos). Assumption: about a sixteenth of the body across.
    eyes size=0.032 color="#141414"
}
hatches {
    southern-sweden from=may to=october time="evening" note="From May (Sericostoma, Hydropsyche; Dalarna 2013) into autumn (Rhyacophila to November; Gullefors 2015); July and August the main months (Gullefors 2014)."
    northern-scandinavia from=june to=september time="evening" note="First adults in early June on the Forsån (Gullefors 2014); caddis fishing in the August dusk (Visit Dalarna)."
    british-isles from=april to=september time="evening" note="Grannom in April (First Nature); many caddis at dusk."
    central-europe from=may to=september time="evening" note="Estimate; mostly at dusk and night (Wikipedia de)."
    northern-usa from=april to=october note="Mother's Day caddis from late April, then May–October (Montana Angler)."
}
sources {
    "Troutnut: Order Trichoptera" url="https://www.troutnut.com/hatch/12/Insect-Trichoptera-Caddisflies"
    "Wikipedia: Caddisfly" url="https://en.wikipedia.org/wiki/Caddisfly"
    "Lingdell & Engblom 2013: Fakta om småkryp i Dalarnas vattendrag (Länsstyrelsen Dalarna, rapport 2013:06)" url="https://catalog.lansstyrelsen.se/store/26/resource/2013_06"
    "Wikipedia (de): Köcherfliegen" url="https://de.wikipedia.org/wiki/Köcherfliegen"
    "UC Riverside, Entomology: Trichoptera" url="https://faculty.ucr.edu/~legneref/entomol/trichoptera.htm"
    "Fritz Müller 1879: Notes on the Cases of some South Brazilian Trichoptera" url="https://archive.org/download/biostor-51205/biostor-51205.pdf"
    "Gullefors 2014: Nattsländorna (Trichoptera) längs Forsån i Ångermanland. Entomologisk Tidskrift 135" url="https://www.sef.nu/download/entomologisk_tidskrift/et_2014/ET-2014-153"
}
references {
    "https://i.troutnut.com/im_regspec/pic_2868_800.jpg" page="https://www.troutnut.com/specimen/668" author="Jason Neuswanger" license="All rights reserved; reference only" note="Cheumatopsyche pupa, side view"
    "https://i.troutnut.com/im_regspec/pic_3261_800.jpg" page="https://www.troutnut.com/specimen/715" author="Jason Neuswanger" license="All rights reserved; reference only" flip=#true note="Hydropsyche pupa, side view, out of its cocoon"
    "https://upload.wikimedia.org/wikipedia/commons/6/66/Rhyacophila-pupa.jpg" page="https://commons.wikimedia.org/wiki/File:Rhyacophila-pupa.jpg" author="Nikita Kluge" license="CC0" flip=#true note="Rhyacophila pupa, side view (drawing)"
}
