// Atlantic salmon parr: young salmon in their river, before they go to sea as smolts.

id salmon-parr
name "Salmon parr"
group baitfish
stage juvenile
examples "Atlantic salmon (Salmo salar) fry and parr"
description "Young Atlantic salmon in their first years in the river, holding in fast, stony riffles: slimmer than trout parr, with a deeply forked tail, long pectoral fins, a short jaw, a row of bluish parr marks along the sides with small red spots between them, and no red on the adipose fin. In spring they turn silver and go to sea as smolts."
// Smolts at about 15 cm (Wikipedia), 12–15 cm in the south of the range (FishBase).
// Assumption: from fry newly up from the gravel to parr about to become smolts, without the tail fin.
size min=30 max=130
rides swimming
body {
    // Fusiform, oval in section (FishBase); a more streamlined body than a trout parr's (Norske
    // Lakseelver); assumption: the slimmer tail stalk the leaflet gives adults, here too. Juveniles: 8–12 blue-violet blotches on the flanks
    // with small red spots between them (FishBase).
    // Assumption: from the photos (flipped), in body lengths without the tail fin: the head 0.24, the
    // body about 0.21 deep, the tail stalk 0.07 deep at the tail fin; ten parr marks from behind the
    // head to the tail stalk; few black spots, on the back above the lateral line.
    tail length=0.3 radius=0.03 taper=2.5 color="#56553a" belly="#ece8d8" flatten=2.6 top=0.036 bottom=0.034
    trunk length=0.465 radius=0.07 taper=1.08 color="#56553a" belly="#efebdc" flatten=2 round=0.4 marks=spots ink="#2a2618" top=0.1 bottom=0.098
    head length=0.235 radius=0.07 taper=0.2 color="#504e34" belly="#e8e4d4" flatten=1.7 top=0.1 bottom=0.095
}
parts {
    // The parr marks, and red spots between them (half a mark along):
    mark section=tail kind=bars side=sides count=4 color="#4a5068"
    mark section=trunk kind=bars side=sides count=6 color="#4a5068"
    mark section=trunk kind=spots side=sides count=6 offset=0.5 color="#c04a30"
    // FishBase counts 3–4 unbranched and 9–15 branched dorsal rays, 3–4 and 7–11 anal; soft in a
    // salmon, so counted here as rays. 19 caudal rays; the tail fin deeply forked below 20 cm
    // (FishBase). Longer pectoral fins than a trout parr's, and no red on the adipose fin (Norske
    // Lakseelver).
    // Assumption: positions and sizes from the photos: the dorsal fin starting a little in front of
    // the middle, the pelvic fins under it, the pectoral fins 0.22 long, the tail fin 0.2.
    fin kind=caudal at=0 base=0.08 height=0.2 rays=19 shape=forked clarity=0.3 color="#6e6a48"
    fin kind=dorsal at=0.52 base=0.19 height=0.12 rays=13 shape=truncate clarity=0.3 color="#5e5a40"
    fin kind=adipose at=0.15 base=0.05 height=0.035 rays=0 clarity=0 color="#6a6848"
    fin kind=anal at=0.22 base=0.12 height=0.09 rays=11 shape=truncate clarity=0.3 color="#a09868"
    fin kind=pelvic at=0.46 base=0.05 height=0.11 clarity=0.3 color="#a09868"
    fin kind=pectoral at=0.78 base=0.05 height=0.22 clarity=0.3 color="#9a9060"
    // A shorter jaw than a trout parr's (Norske Lakseelver); the mouth reaches only below the rear
    // of the eye (FishBase). Usually only one to a few spots on the gill cover (Norske Lakseelver).
    // Assumption: from the photos, the mouth 0.08 of the length; a large eye, 0.065 across; scales
    // about 0.008 of the length.
    mouth position=terminal size=0.08
    gill-cover at=0.765
    eyes size=0.032 color="#1a1a14" iris="#c0b080" pupil="#0a0a08"
    scales size=0.008 shine=0.15
    // Assumption: the lateral line a little above the middle of the flank, faintly darker.
    lateral-line height=0.05 color="#3a3826"
}
hatches {
    southern-sweden from=january to=december note="Estimate: in the river all year, one to four years; the smolts go to sea mostly from March to June (Wikipedia)."
    northern-scandinavia from=january to=december note="Estimate: in the river all year, up to five or six years in the far north (FishBase); the smolts go to sea mostly from March to June (Wikipedia)."
    british-isles from=january to=december note="Estimate: in the river all year, one to four years; the smolts go to sea mostly from March to June (Wikipedia)."
    northern-usa from=january to=december note="Estimate: only in a few rivers in Maine (the USFWS photos are from the Machias River)."
}
sources {
    "Wikipedia: Atlantic salmon" url="https://en.wikipedia.org/wiki/Atlantic_salmon"
    "Wikipedia: Parr (fish)" url="https://en.wikipedia.org/wiki/Parr_(fish)"
    "FishBase: Salmo salar" url="https://www.fishbase.se/summary/Salmo-salar.html"
    "Norske Lakseelver: Salmon recognition (leaflet, 2019)" url="https://lakseelver.no/sites/default/files/Gjenkjenningsfolder%2C%20engelsk%2C%202019.pdf"
}
// Photos for checking proportions while authoring (pnpm refcheck); never published.
references {
    "https://upload.wikimedia.org/wikipedia/commons/2/2e/Salmo_salar_221451741_%28cropped%29.jpg" page="https://commons.wikimedia.org/wiki/File:Salmo_salar_221451741_(cropped).jpg" author="Ben Rushbrooke" license="CC BY 4.0" flip=#true note="Two parr on a ruler, side view, about 11 and 5.5 cm"
    "https://upload.wikimedia.org/wikipedia/commons/b/b3/Atlantic_salmon_parr.jpg" page="https://commons.wikimedia.org/wiki/File:Atlantic_salmon_parr.jpg" author="Peter Steenstra, USFWS" license="Public domain" flip=#true note="Parr swimming over gravel, parr marks and red spots"
    "https://upload.wikimedia.org/wikipedia/commons/c/c2/Atlantic_Salmon_Parr_in_Cobble_Habitat_%285198590436%29.jpg" page="https://commons.wikimedia.org/wiki/File:Atlantic_Salmon_Parr_in_Cobble_Habitat_(5198590436).jpg" author="USFWS Northeast Region" license="Public domain" flip=#true note="Parr of about 8 cm in the Machias River, Maine"
}
