// Atlantic silverside 5–9 cm, mostly translucent with a silver band (Wikipedia); sand eel very slender, up to 20 cm (Wikipedia).

id marine-baitfish
name "Marine baitfish"
group baitfish
stage adult
examples "silversides, sand eels, smelt, glass minnows"
description "The slim schooling fish of coasts and estuaries: a translucent body with a silver band along the side, a green-grey back and a white belly. Sea trout and saltwater fish feed on them in the shallows."
size min=40 max=120
rides swimming
body {
    // Drawn after the Atlantic silverside: mostly translucent, with a silver stripe the length of
    // the body along the lateral line and brown speckling on the head and upper back; rounder
    // and less compressed than its relatives (Wikipedia). Lengths leave out the tail fin.
    // Assumption: from the drawing on Wikipedia's Atlantic silverside page, the head about 0.22
    // of the length, the body about a sixth as deep as long, the tail's narrow end about 0.06.
    tail length=0.28 radius=0.055 taper=0.45 color="#7a8a6a" belly="#e8eef0" flatten=1.6 translucency=0.35 marks=stripe ink="#dfe6ea"
    trunk length=0.5 radius=0.068 taper=0.95 color="#7a8a6a" belly="#eef2f4" flatten=1.4 translucency=0.35 marks=stripe ink="#dfe6ea"
    head length=0.22 radius=0.066 taper=0.45 color="#6a7a5a" belly="#e8eef0" flatten=1.4 translucency=0.2 round=0.6
}
parts {
    // Two dorsal fins, a spiny one and a soft one behind it (Wikipedia: Atlantic
    // silverside); a forked tail, as the sand eel's (Wikipedia: Lesser sand eel).
    // Assumption: positions and sizes read off the drawing: the first dorsal fin starting just
    // behind the middle, over the start of the long anal fin; the pelvic fins well ahead of
    // them; the pectoral fins high behind the head.
    fin kind=caudal at=0 size=0.18 color="#b8c0b8"
    fin kind=dorsal at=0.46 size=0.08 color="#b8c0b8"
    fin kind=dorsal at=0.32 size=0.1 color="#b8c0b8"
    fin kind=anal at=0.44 size=0.14 color="#b8c0b8"
    fin kind=pelvic at=0.63 size=0.07 color="#b8c0b8"
    fin kind=pectoral at=0.76 size=0.1 color="#b8c0b8"
    eyes size=0.032 color="#1a1a14"
}
hatches {
    southern-sweden from=january to=december note="Estimate."
    northern-scandinavia from=january to=december note="Estimate."
    british-isles from=january to=december note="Estimate."
    central-europe from=january to=december note="Estimate."
    northern-usa from=january to=december note="Estimate."
}
sources {
    "Wikipedia: Atlantic silverside" url="https://en.wikipedia.org/wiki/Atlantic_silverside"
    "Wikipedia: Lesser sand eel" url="https://en.wikipedia.org/wiki/Lesser_sand_eel"
}
