// Atlantic silverside 5–9 cm, mostly translucent with a silver band (Wikipedia); sand eel very slender, up to 20 cm (Wikipedia).

id marine-baitfish
name "Marine baitfish"
group baitfish
stage adult
examples "silversides, sand eels, smelt, glass minnows"
description "The slim schooling fish of coasts and estuaries: a translucent body with a silver band along the side, a green-grey back and a white belly. Sea trout and saltwater fish feed on them in the shallows."
size min=40 max=120
rides swimming
body {
    tail length=0.3 radius=0.05 taper=0.35 color="#7a8a6a" belly="#e8eef0" flatten=1.8 translucency=0.3
    trunk length=0.5 radius=0.065 taper=0.95 color="#7a8a6a" belly="#eef2f4" flatten=1.6 translucency=0.3
    head length=0.2 radius=0.06 taper=0.5 color="#6a7a5a" belly="#e8eef0" flatten=1.5 translucency=0.2 round=0.6
}
parts {
    fin kind=caudal at=0 size=0.22 color="#b8c0b8"
    fin kind=dorsal at=0.45 size=0.14 color="#b8c0b8"
    fin kind=anal at=0.3 size=0.1 color="#b8c0b8"
    fin kind=pelvic at=0.5 size=0.08 color="#b8c0b8"
    fin kind=pectoral at=0.78 size=0.1 color="#b8c0b8"
    eyes size=0.03 color="#1a1a14"
}
hatches {
    southern-sweden from=january to=december note="All year (estimate)."
    northern-scandinavia from=january to=december note="All year (estimate)."
    british-isles from=january to=december note="All year (estimate)."
    central-europe from=january to=december note="All year (estimate)."
    northern-usa from=january to=december note="All year (estimate)."
}
sources {
    "Wikipedia: Atlantic silverside" url="https://en.wikipedia.org/wiki/Atlantic_silverside"
    "Wikipedia: Lesser sand eel" url="https://en.wikipedia.org/wiki/Lesser_sand_eel"
}
