id grasshopper
name "Grasshopper"
group terrestrial
stage adult
examples "field and meadow grasshoppers (Chorthippus)"
description "A long-bodied insect with big jumping hind legs, folded wings and short antennae. Blown or jumping onto the water, it lands with a splash and kicks."
size min=15 max=25
rides on-surface
// Assumption: fallen on the water it lies in the film, body and legs on the surface (photos).
sits body
body {
    // Field grasshopper: brownish, in striped and mottled forms; the underside distinctly hairy
    // (ORS). The pronotum 3.1 mm in males, 3.9 mm in females (Tarasova et al.): about a fifth of
    // the body, taking males at about 15 mm and females at 20 (ORS gives 15–25). Eleven abdominal
    // segments, the last three reduced (Wikipedia: Grasshopper).
    // Assumption: from the photo on Wikipedia's Chorthippus brunneus page, the head 0.14 of the
    // body, the whole thorax 0.28, and the body about a fifth as deep as long.
    abdomen length=0.58 radius=0.05 taper=1.6 segments=8 color="#7a6a3a" belly="#a8985a" flatten=1.2
    thorax length=0.28 radius=0.085 taper=0.9 color="#6a5a32" belly="#8a7a4a" flatten=1.4 hairs=0.15 marks=stripe ink="#3a3020"
    head length=0.14 radius=0.09 taper=0.75 color="#6a5a32" flatten=1.3
}
parts {
    // Narrow leathery fore wings over large membranous hind wings (Wikipedia: Grasshopper),
    // reaching past the hind knees (DELTA); the fore wing 14.3 mm in males, 17.1 mm in females
    // (Tarasova et al.), about 0.85 of a female's body (0.95 of a male's). Often mottled (ORS; Wikipedia).
    // Assumption: the hind wings, folded underneath, nearly as long as the fore wings.
    wings count=4 shape=back length=0.85 width=0.15 color="#7a6a42" clarity=0.1 veins=#true hind=0.95 mottle="#3a2e1e"
    // The hind femur 9.6 mm in males and 12.2 mm in females (Tarasova et al.), about 0.6 of the
    // body; a robust, ridged femur and a spined tibia (Wikipedia: Grasshopper).
    // Assumption: the hind tibia a little shorter than the femur and the foot short, so the hind
    // leg about 1.3 times the body; the other legs about 0.38 of it.
    // Three-jointed feet (assumption, as in grasshoppers generally); the hind thigh held raised along the body with the
    // shin folded under it. Assumption: the thigh about 0.05 of the body deep at its widest (photos).
    legs count=6 length=0.38 color="#7a6a3a" femur=0.38 tibia=0.36 tarsi=3
    legs pair=hind count=2 length=1.3 color="#7a6a3a" femur=0.46 tibia=0.42 tarsi=3 pose=jumping
    // Short antennae (Wikipedia: Grasshopper; DELTA). Assumption: about 0.4 of the body, from
    // the photo (a male's; a female's are shorter).
    // Thread-like, with fewer segments than a cricket's 20–24 or more (Wikipedia: Grasshopper). Assumption: 20 segments.
    antennae length=0.4 color="#6a5a32" segments=20
    // The pronotum 3.1 mm in males, 3.9 mm in females (Tarasova et al.), about a fifth of the body; a saddle over the
    // front of the thorax. Assumption: about as wide as the head.
    pronotum length=0.19 width=0.17 color="#6a5a32"
    // Large compound eyes and three simple eyes (Wikipedia: Grasshopper).
    eyes size=0.035 color="#3a3020" ocelli=#true
}
hatches {
    southern-sweden from=july to=september note="Estimate."
    northern-scandinavia from=july to=august note="Estimate."
    british-isles from=june to=november note="Field grasshopper adults June to early December (ORS)."
    central-europe from=july to=october note="Estimate."
    northern-usa from=july to=september note="Hoppers from mid-July on the Madison (Montana Angler); the end is an estimate."
}
sources {
    "Grasshoppers and Related Insects Recording Scheme: Chorthippus brunneus" url="https://orthoptera.org.uk/node/3354"
    "Wikipedia: Meadow grasshopper" url="https://en.wikipedia.org/wiki/Meadow_grasshopper"
    "Wikipedia: Grasshopper" url="https://en.wikipedia.org/wiki/Grasshopper"
    "Wikipedia: Chorthippus brunneus" url="https://en.wikipedia.org/wiki/Chorthippus_brunneus"
    "DELTA, British Orthoptera: Chorthippus" url="https://www.delta-intkey.com/britin/ort/www/chorthip.htm"
    "Tarasova, Tishechkin and Vedenina 2021, ZooKeys 1073: Table 1, morphology of the Chorthippus biguttulus group" url="https://zenodo.org/records/15143081"
    "Montana Angler: Madison River hatch chart" url="https://www.montanaangler.com/montana-fly-fishing-rivers/madison-river-hatch-chart-fishing"
}
references {
    "https://upload.wikimedia.org/wikipedia/commons/0/0c/Grasshopper_April_2008-3.jpg" page="https://commons.wikimedia.org/wiki/File:Grasshopper_April_2008-3.jpg" author="Alvesgaspar" license="CC BY-SA 3.0" note="Chorthippus brunneus, side view"
    "https://upload.wikimedia.org/wikipedia/commons/e/e0/Chorthippus_brunneus_Piazzo_02.jpg" page="https://commons.wikimedia.org/wiki/File:Chorthippus_brunneus_Piazzo_02.jpg" author="Syrio" license="CC BY-SA 4.0" note="Chorthippus brunneus, side view"
    "https://upload.wikimedia.org/wikipedia/commons/d/d1/Brauner_Grash%C3%BCpfer_w.jpg" page="https://commons.wikimedia.org/wiki/File:Brauner_Grash%C3%BCpfer_w.jpg" author="ThoBel-0043" license="CC BY-SA 4.0" flip=#true note="Chorthippus brunneus female, side view"
}
